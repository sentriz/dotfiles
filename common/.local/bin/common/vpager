#!/usr/bin/env bash

set -u

if [[ $# -gt 0 ]]; then
    exec nvim -R -- "$@"
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
cat >"$tmp"

size=$(stty size </dev/tty 2>/dev/null)
rows=${size%% *}

if [[ -z $rows ]] || (($(wc -l <"$tmp") < rows)); then
    cat "$tmp"
    exit 0
fi

nvim </dev/tty -i NONE \
    --cmd "let g:pager = v:true" \
    -c "terminal cat $tmp" \
    -c "setlocal nonumber signcolumn=no scrollback=1000000" \
    -c "autocmd TermClose * ++once normal! L"
