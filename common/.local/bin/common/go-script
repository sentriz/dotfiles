#!/usr/bin/env sh

set -eu

scripts_dir="$XDG_CACHE_HOME/go-scripts"
mkdir -p "$scripts_dir"

src="$(readlink -f "$1")"
shift

sum=$(sha1sum "$src" | grep -Eo '^\w+')
bin="$scripts_dir/$sum"

test -f "$bin" \
    && exec "$bin" "$@"

(
    dir="$(mktemp -d)"
    cd "$dir" || exit 1

    cp "$src" "$dir/m.go"
    sed -i '/^#/d' "$dir/m.go"

    go mod init tmp
    go get ./...
    go build -o "$bin"

    rm -r "$dir"
) 1>&2

exec "$bin" "$@"
