#!/usr/bin/env bash

set -u

[ $# -eq 0 ] && {
    echo "usage:" >&2
    echo "  secret <key>" >&2
    echo "  secret list" >&2
    echo "  secret write <key> <value>" >&2
    echo "  secret daemon" >&2
    echo "  secret socket-path" >&2
    exit 1
}

action=$1

# termux has no XDG_RUNTIME_DIR; use its private TMPDIR
socket_path="${XDG_RUNTIME_DIR:-$TMPDIR}/secrets-socket"

folder=dotfiles
prefix=secret

need-vault() {
    # termux has no XDG_RUNTIME_DIR; use TMPDIR/rbw-<uid> to match rbw's runtime_dir() in src/dirs.rs
    local rbw_dir="${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/rbw}"
    rbw_dir="${rbw_dir:-$TMPDIR/rbw-$(id -u)}"
    [ -S "$rbw_dir/socket" ] && return

    echo "secret $action: needs a local vault" >&2

    exit 1
}

case "$action" in
socket-path)
    printf '%s\n' "$socket_path"
    ;;
daemon)
    socat -T1 - "UNIX-CONNECT:$socket_path" </dev/null &>/dev/null && exit 0

    pkill -f "UNIX-LISTEN:$socket_path,"
    mkdir -p "${socket_path%/*}"
    setsid socat -t10 "UNIX-LISTEN:$socket_path,fork,mode=600,unlink-early" "EXEC:$(command -v "$0") serve" &>/dev/null &

    for _ in $(seq 50); do
        [ -S "$socket_path" ] && exit 0
        sleep 0.05
    done

    echo "timed out starting secrets daemon at $socket_path" >&2
    exit 1
    ;;
serve)
    read -r key || exit 1
    if result=$( { need-vault && rbw get --folder "$folder" --field notes "$prefix $key"; } 2>&1); then
        printf 'ok\n%s\n' "$result"
    else
        printf 'error\nsecret %s on %s: %s\n' "$key" "$(uname -n)" "$result"
        exit 1
    fi
    ;;
write)
    need-vault
    printf '\n%s\n' "$3" | rbw edit --folder "$folder" "$prefix $2" 2>/dev/null \
        || printf '\n%s\n' "$3" | rbw add --folder "$folder" "$prefix $2"
    ;;
list)
    need-vault
    rbw list --fields folder,name | grep -P "$folder\t$prefix" | col -1 | col " " -1
    ;;
*)
    set -o pipefail
    socat -t10 - "UNIX-CONNECT:$socket_path" <<<"$action" | {
        if ! IFS= read -r status; then
            printf 'secret %s: no response from %s; check the secrets daemon or SSH forwarding\n' "$action" "$socket_path" >&2
            exit 1
        fi

        case "$status" in
        ok)
            cat
            ;;
        error)
            cat >&2
            exit 1
            ;;
        *)
            printf 'secret %s: invalid response; check secret versions on the client and vault host\n' "$action" >&2
            exit 1
            ;;
        esac
    }
    ;;
esac
