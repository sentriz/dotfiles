#!/usr/bin/env bash

set -u

[ $# -eq 0 ] && {
    echo "usage:" >&2
    echo "  secret <key>" >&2
    echo "  secret list" >&2
    echo "  secret write <key> <value>" >&2
    echo "  secret daemon" >&2
    exit 1
}

action=$1

folder=dotfiles
prefix=secret

# mirrors rbw's runtime_dir() in src/dirs.rs: $XDG_RUNTIME_DIR/rbw, falling back to $TMPDIR/rbw-<uid> where there is none, ie termux
rbw_dir="${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/rbw}"
rbw_dir="${rbw_dir:-$TMPDIR/rbw-$(id -u)}"

need-vault() {
    [ -S "$rbw_dir/socket" ] && return

    if [ -n "${SECRETS_SOCK-}" ]; then
        echo "secret $action: needs a local vault, this host can only read secrets" >&2
    else
        echo "secret $action: needs a local vault" >&2
    fi

    exit 1
}

case "$action" in
daemon)
    socat -T1 - "UNIX-CONNECT:$SECRETS_SOCK" </dev/null &>/dev/null && exit 0

    mkdir -p "${SECRETS_SOCK%/*}"
    setsid socat -t10 "UNIX-LISTEN:$SECRETS_SOCK,fork,mode=600,unlink-early" "EXEC:$(command -v "$0") serve" &>/dev/null &

    for _ in $(seq 50); do
        [ -S "$SECRETS_SOCK" ] && exit 0
        sleep 0.05
    done

    echo "timed out starting secrets daemon at $SECRETS_SOCK" >&2
    exit 1
    ;;
serve)
    need-vault
    read -r key
    rbw get --folder "$folder" --field notes "$prefix $key" 2>/dev/null
    ;;
write)
    need-vault
    printf '\n%s\n' "$3" | rbw edit --folder "$folder" "$prefix $2" 2>/dev/null \
        || printf '\n%s\n' "$3" | rbw add --folder "$folder" "$prefix $2"
    ;;
list)
    need-vault
    rbw list --fields folder,name | grep -P "$folder\t$prefix" | col -1 | col " " -1
    ;;
*)
    exec socat -t10 - "UNIX-CONNECT:$SECRETS_SOCK" <<<"$action"
    ;;
esac
