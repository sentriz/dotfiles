#!/usr/bin/env bash

set -u

extra_dirs=()
cmd_args=()
parsing_binds=""
for arg in "$@"; do
    if [ -n "$parsing_binds" ]; then
        extra_dirs+=("$(realpath "$arg")")
    elif [ "$arg" = "--" ]; then
        parsing_binds=1
    else
        cmd_args+=("$arg")
    fi
done

cmd=("$(PATH="/usr/bin:/usr/local/bin" command -v pi)" "${cmd_args[@]}")

if [ -n "${PI_SHELL-}" ]; then
    [ ${#cmd_args[@]} -gt 0 ] || {
        echo "usage: PI_SHELL=1 pi <cmd> [args...]" >&2
        exit 1
    }
    cmd=("${cmd_args[@]}")
fi

if [ -n "${PI_UNSANDBOXED-}" ]; then
    PI_CODING_AGENT_DIR="$XDG_CONFIG_HOME/pi/agent" PI_OFFLINE=1 exec "${cmd[@]}"
fi

cwd=$(realpath "$PWD")

ro_paths=()
ro() { ro_paths+=("$@"); }

rw_paths=()
rw() { rw_paths+=("$@"); }

keep_paths=()
keep() {
    keep_paths+=("$@")
    rw "$@"
}

override_args=()
blank() { for path in "$@"; do override_args+=(--tmpfs "$path"); done; }
redirect() { override_args+=(--bind "$1" "$2"); }

base_args=()
env_args=()

# system
base_args+=(--dev /dev --proc /proc --tmpfs /tmp --tmpfs /var/tmp --tmpfs "$XDG_RUNTIME_DIR")
base_args+=(--symlink usr/bin /bin --symlink usr/bin /sbin --symlink usr/lib /lib --symlink usr/lib /lib64)
ro /usr /etc /opt /run/systemd/resolve

# workspace
[ "$cwd" = "$HOME" ] || rw "$cwd"
rw "$PROJECTS_DIR" "${extra_dirs[@]}" "$XDG_DOWNLOAD_DIR"

# pi
rw "$XDG_CONFIG_HOME/pi"
keep "$XDG_CACHE_HOME/pi" "$XDG_RUNTIME_DIR/pi"
env_args+=(--setenv PI_CODING_AGENT_DIR "$XDG_CONFIG_HOME/pi/agent" --setenv PI_OFFLINE 1)
keep "$XDG_CACHE_HOME/jiti"
redirect "$XDG_CACHE_HOME/jiti" /tmp/jiti

# shell
IFS=: read -ra path_entries <<<"$PATH"
ro "${path_entries[@]}" "$XDG_CONFIG_HOME/fish"
rw "$XDG_CACHE_HOME/fish"

# secrets
rw "$SECRETS_SOCK"

# ssh
if [ -n "${PI_SSH-}" ]; then
    ro "$HOME/.ssh/config" "$HOME/.ssh/known_hosts"
    rw "${SSH_AUTH_SOCK-}"
    blank /etc/ssh/ssh_config.d
else
    env_args+=(--unsetenv SSH_AUTH_SOCK)
fi

# git and github
ro "$XDG_CONFIG_HOME/git"
rw "$XDG_CONFIG_HOME/gh" "$XDG_CACHE_HOME/gh" "$XDG_DATA_HOME/gh"

# mcp
ro "$XDG_CONFIG_HOME/mcp"
rw "$XDG_CACHE_HOME/mcp"
keep "$XDG_RUNTIME_DIR/mcp"

# aws
keep "$XDG_CACHE_HOME/aws"

# tasks
rw "$XDG_DATA_HOME/tasks"

# notes
rw "$NOTES_DIR/machines"

# go
ro "$XDG_CONFIG_HOME/go"
rw "$GOPATH/pkg/mod" "$XDG_CACHE_HOME"/{go,go-build,gopls,golangci-lint}

# node, bun, and deno
ro "${NPM_CONFIG_INIT_MODULE%/*}"
rw "$NPM_CONFIG_CACHE" "$NPM_CONFIG_PREFIX" "$BUN_INSTALL_CACHE_DIR"
rw "$XDG_CACHE_HOME"/{node-gyp,typescript,bun,deno}

# python
rw "$XDG_CACHE_HOME"/{uv,pip} "$XDG_DATA_HOME"/{uv,pipx} "$XDG_STATE_HOME/pipx"

# rust, c, and zig
rw "$CARGO_HOME" "$XDG_CACHE_HOME"/{ccache,zig}

# direnv
rw "$XDG_DATA_HOME/direnv"

bind_args=()
add-binds() {
    local mode="$1" paths=() targets=() path target i
    shift
    for path in "$@"; do
        [ -e "$path" ] && paths+=("$path")
    done
    [ ${#paths[@]} -gt 0 ] || return 0

    mapfile -t targets < <(realpath "${paths[@]}")
    for i in "${!paths[@]}"; do
        path="${paths[i]}" target="${targets[i]}"
        case "$target" in /usr/*) continue ;; esac
        [ -L "$path" ] && bind_args+=(--symlink "$target" "$path")
        bind_args+=("$mode" "$target" "$target")
    done
}

mkdir -p "${keep_paths[@]}"

# read-only first, so a writable group wins wherever it is declared
add-binds --ro-bind "${ro_paths[@]}"
add-binds --bind "${rw_paths[@]}"

socks=()
cleanups=""

trap 'eval "$cleanups"; true' EXIT HUP INT TERM

# notifications
if [ -n "${DBUS_SESSION_BUS_ADDRESS-}" ]; then
    dbus_sock="$XDG_RUNTIME_DIR/pi/bus.$$"
    setpriv --pdeathsig=TERM xdg-dbus-proxy "$DBUS_SESSION_BUS_ADDRESS" "$dbus_sock" --filter --talk=org.freedesktop.Notifications &
    cleanups+="kill $!; rm -f ${dbus_sock@Q}; "
    socks+=("$dbus_sock")
    override_args+=(--bind-try "$dbus_sock" "$dbus_sock")
    env_args+=(--setenv DBUS_SESSION_BUS_ADDRESS "unix:path=$dbus_sock")
fi

# clipboard
if [ -n "${WAYLAND_DISPLAY-}" ]; then
    wayland_sock="$XDG_RUNTIME_DIR/pi/wayland.$$"
    setpriv --pdeathsig=TERM way-secure --socket-path "$wayland_sock" -e pi -a pi &
    cleanups+="kill $!; rm -f ${wayland_sock@Q}; "
    socks+=("$wayland_sock")
    override_args+=(--bind-try "$wayland_sock" "$wayland_sock")
    env_args+=(--setenv WAYLAND_DISPLAY "$wayland_sock")
fi

env_args+=(--unsetenv SWAYSOCK)

# speech
# one player per clip: pw-play reads in pipewire's rt thread, so a reader parked on an
# idle fifo would stall the whole graph. eof ends it and the loop blocks in open() instead.
speak_fifo="$XDG_RUNTIME_DIR/pi/speak.$$"
mkfifo "$speak_fifo"
IFS=$'\t' read -r sample_format rate channels < <(speak --format)
# shellcheck disable=SC2016
setpriv --pdeathsig=TERM bash -c '
    player=""
    trap "kill \$player 2>/dev/null; exit" TERM
    while :; do
        pw-play --raw --format "$1" --rate "$2" --channels "$3" "$4" &
        player=$!
        wait "$player" || exit
    done
' _ "$sample_format" "$rate" "$channels" "$speak_fifo" &
cleanups+="kill $! 2>/dev/null; rm -f ${speak_fifo@Q}; "
env_args+=(--setenv SPEAK_FIFO "$speak_fifo")

for ((i = 0; i < 200; i++)); do
    missing=""
    for sock in "${socks[@]}"; do [ -e "$sock" ] || missing=1; done
    [ -z "$missing" ] && break
    sleep 0.005
done

bwrap \
    "${base_args[@]}" \
    "${bind_args[@]}" \
    "${override_args[@]}" \
    "${env_args[@]}" \
    --chdir "$cwd" \
    --unshare-all \
    --share-net \
    --die-with-parent \
    "${cmd[@]}"
