///bin/true; exec go-script "$0" "$@"
// vi: ft=go

package main

import (
	"bufio"
	"bytes"
	"crypto/sha1"
	"encoding/hex"
	"encoding/json"
	"fmt"
	"net/url"
	"os"
	"os/exec"
	"path/filepath"
	"regexp"
	"slices"
	"strconv"
	"strings"
	"sync"
	"time"

	"github.com/emersion/go-ical"
)

const listPrefix = "List : "

var forges = map[string]func(repo string) ([]item, error){
	"github.com": githubItems,
}

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func run() error {
	if len(os.Args) != 2 {
		return fmt.Errorf("usage: %s <vdir calendar dir> < project paths", os.Args[0])
	}
	dir := os.Args[1]

	entries, err := os.ReadDir(dir)
	if err != nil {
		return fmt.Errorf("read dir: %w", err)
	}

	var lists = map[string]string{}
	var tasks = map[string]task{}
	for _, entry := range entries {
		if filepath.Ext(entry.Name()) != ".ics" {
			continue
		}

		filePath := filepath.Join(dir, entry.Name())
		f, err := os.Open(filePath)
		if err != nil {
			return fmt.Errorf("open %s: %w", entry.Name(), err)
		}
		cal, err := ical.NewDecoder(f).Decode()
		f.Close()
		if err != nil {
			return fmt.Errorf("decode %s: %w", entry.Name(), err)
		}

		for _, comp := range cal.Children {
			if comp.Name != ical.CompToDo {
				continue
			}
			uid, _ := comp.Props.Text(ical.PropUID)

			summary, _ := comp.Props.Text(ical.PropSummary)
			if name, ok := strings.CutPrefix(summary, listPrefix); ok {
				lists[name] = uid
			}

			if urlProp := comp.Props.Get(ical.PropURL); urlProp != nil && uid == hash(urlProp.Value) {
				tasks[urlProp.Value] = task{path: filePath, cal: cal, todo: comp}
			}
		}
	}

	now := time.Now()

	sc := bufio.NewScanner(os.Stdin)
	for sc.Scan() {
		projectPath := strings.TrimSpace(sc.Text())
		if projectPath == "" {
			continue
		}
		name := filepath.Base(projectPath)

		out, err := exec.Command("git", "-C", projectPath, "remote", "get-url", "origin").Output()
		if err != nil {
			fmt.Fprintf(os.Stderr, "skipping %s: no origin remote\n", name)
			continue
		}
		remote := strings.TrimSuffix(strings.TrimSpace(string(out)), ".git")

		var host, repo string
		if u, err := url.Parse(remote); err == nil && u.Host != "" {
			host, repo = u.Hostname(), strings.TrimPrefix(u.Path, "/")
		} else {
			hostPath := remote
			if _, after, ok := strings.Cut(remote, "@"); ok {
				hostPath = after
			}
			host, repo, _ = strings.Cut(hostPath, ":")
		}

		listItems, ok := forges[host]
		if !ok {
			fmt.Fprintf(os.Stderr, "skipping %s: unsupported forge %s\n", name, host)
			continue
		}
		forgeItems, err := listItems(repo)
		if err != nil {
			fmt.Fprintf(os.Stderr, "skipping %s: %v\n", name, err)
			continue
		}

		var open = map[string]struct{}{}
		var items = make([]item, 0, len(forgeItems))
		for _, item := range forgeItems {
			open[item.URL] = struct{}{}

			categories, priority, ok := rules(item, now)
			if !ok {
				continue
			}
			item.Categories, item.Priority = categories, priority
			items = append(items, item)
		}

		listUID, ok := lists[name]
		if !ok && len(items) > 0 {
			listUID = hash(listPrefix + name)
			list := newTask(filepath.Join(dir, listUID+".ics"), listUID, listPrefix+name)
			if err := writeTask(list); err != nil {
				return err
			}
			lists[name] = listUID
		}

		for _, item := range items {
			task, ok := tasks[item.URL]
			var dirty = !ok
			if !ok {
				uid := hash(item.URL)
				task = newTask(filepath.Join(dir, uid+".ics"), uid, item.Ref+" "+item.Title)
				task.todo.Props.SetText(ical.PropRelatedTo, listUID)
				prop := ical.NewProp(ical.PropURL)
				prop.Value = item.URL
				task.todo.Props.Set(prop)
			}
			var categories []string
			for _, prop := range task.todo.Props.Values(ical.PropCategories) {
				list, _ := prop.TextList()
				categories = append(categories, list...)
			}
			if missing := slices.DeleteFunc(slices.Clone(item.Categories), func(c string) bool { return slices.Contains(categories, c) }); len(missing) > 0 {
				prop := ical.NewProp(ical.PropCategories)
				prop.SetTextList(append(categories, missing...))
				task.todo.Props.Set(prop)
				dirty = true
			}
			if prop := task.todo.Props.Get(ical.PropPriority); prop == nil || prop.Value != strconv.Itoa(item.Priority) {
				prop := ical.NewProp(ical.PropPriority)
				prop.Value = strconv.Itoa(item.Priority)
				task.todo.Props.Set(prop)
				dirty = true
			}
			if task.todo.Props.Get(ical.PropCreated) == nil {
				task.todo.Props.SetDateTime(ical.PropCreated, item.CreatedAt.UTC())
				dirty = true
			}
			if !dirty {
				continue
			}
			task.todo.Props.SetDateTime(ical.PropDateTimeStamp, time.Now().UTC())
			if err := writeTask(task); err != nil {
				return err
			}
		}

		repoURL := "https://" + host + "/" + repo + "/"
		for itemURL, task := range tasks {
			if !strings.HasPrefix(itemURL, repoURL) {
				continue
			}
			if _, ok := open[itemURL]; ok {
				continue
			}
			if status, _ := task.todo.Props.Text(ical.PropStatus); status == "COMPLETED" {
				continue
			}
			now := time.Now().UTC()
			task.todo.Props.SetText(ical.PropStatus, "COMPLETED")
			task.todo.Props.SetDateTime(ical.PropCompleted, now)
			task.todo.Props.SetDateTime(ical.PropDateTimeStamp, now)
			if err := writeTask(task); err != nil {
				return err
			}
		}
	}
	if err := sc.Err(); err != nil {
		return fmt.Errorf("read stdin: %w", err)
	}

	return nil
}

type item struct {
	Kind        string
	Ref         string
	Title       string
	URL         string
	CreatedAt   time.Time
	Labelled    bool
	Mine        bool
	Dependabot  bool
	Draft       bool
	Conflicting bool
	CIFailing   bool
	Size        int
	Severity    string

	Categories []string
	Priority   int
}

const (
	kindIssue       = "issue"
	kindPullRequest = "pull-request"
	kindAdvisory    = "advisory"
)

const (
	priorityNone   = 0
	priorityHigh   = 1
	priorityMedium = 5
	priorityLow    = 9
)

const day = 24 * time.Hour

var releaseTitle = regexp.MustCompile(`^chore(\(.+\))?: release `)

func rules(item item, now time.Time) (categories []string, priority int, ok bool) {
	age := now.Sub(item.CreatedAt)

	if item.Kind == kindAdvisory {
		switch item.Severity {
		case "critical", "high":
			return []string{kindAdvisory}, priorityHigh, true
		default:
			return []string{kindAdvisory}, priorityMedium, true
		}
	}

	if item.Kind == kindIssue {
		switch {
		case item.Labelled:
			return nil, 0, false
		case !item.Mine && age < 60*day:
			return []string{kindIssue}, priorityHigh, true
		default:
			return []string{kindIssue}, priorityMedium, true
		}
	}

	categories = []string{kindPullRequest}
	if item.Dependabot {
		categories = append(categories, "dependabot")
	}

	switch {
	case releaseTitle.MatchString(item.Title):
		return append(categories, "release"), priorityNone, true
	case item.Draft, item.Conflicting, item.CIFailing && item.Size >= 20:
		return categories, priorityLow, true
	case !item.Mine && !item.Dependabot && age < 90*day:
		return categories, priorityHigh, true
	default:
		return categories, priorityMedium, true
	}
}

type task struct {
	path string
	cal  *ical.Calendar
	todo *ical.Component
}

func newTask(path, uid, summary string) task {
	todo := ical.NewComponent(ical.CompToDo)
	todo.Props.SetText(ical.PropUID, uid)
	todo.Props.SetDateTime(ical.PropDateTimeStamp, time.Now().UTC())
	todo.Props.SetText(ical.PropStatus, "NEEDS-ACTION")
	todo.Props.SetText(ical.PropSummary, summary)

	cal := ical.NewCalendar()
	cal.Props.SetText(ical.PropVersion, "2.0")
	cal.Props.SetText(ical.PropProductID, "-//senan//forge-tasks//EN")
	cal.Children = append(cal.Children, todo)
	return task{path: path, cal: cal, todo: todo}
}

func writeTask(t task) error {
	var buf bytes.Buffer
	if err := ical.NewEncoder(&buf).Encode(t.cal); err != nil {
		return fmt.Errorf("encode %s: %w", t.path, err)
	}
	if err := os.WriteFile(t.path, buf.Bytes(), 0o600); err != nil {
		return fmt.Errorf("write %s: %w", t.path, err)
	}
	return nil
}

func hash(s string) string {
	sum := sha1.Sum([]byte(s))
	return hex.EncodeToString(sum[:])
}

func githubItems(repo string) ([]item, error) {
	me, err := githubMe()
	if err != nil {
		return nil, err
	}

	var repoInfo struct {
		HasIssuesEnabled bool `json:"hasIssuesEnabled"`
		IsPrivate        bool `json:"isPrivate"`
	}
	if err := githubJSON(&repoInfo, "repo", "view", repo, "--json", "hasIssuesEnabled,isPrivate"); err != nil {
		return nil, err
	}

	var issues []githubItem
	if repoInfo.HasIssuesEnabled {
		if err := githubJSON(&issues, "issue", "list", "--repo", repo, "--state", "open", "--limit", "1000", "--json", "number,title,url,labels,createdAt,author"); err != nil {
			return nil, err
		}
	}
	var prs []githubItem
	if err := githubJSON(&prs, "pr", "list", "--repo", repo, "--state", "open", "--limit", "1000", "--json", "number,title,url,labels,createdAt,author,isDraft,mergeable,statusCheckRollup,additions,deletions"); err != nil {
		return nil, err
	}
	var advisories []githubAdvisory
	if !repoInfo.IsPrivate {
		if err := githubJSON(&advisories, "api", "repos/"+repo+"/security-advisories?per_page=100"); err != nil {
			return nil, err
		}
	}

	var items = make([]item, 0, len(issues)+len(prs)+len(advisories))
	for _, issue := range issues {
		items = append(items, item{
			Kind:      kindIssue,
			Ref:       "#" + strconv.Itoa(issue.Number),
			Title:     issue.Title,
			URL:       issue.URL,
			CreatedAt: issue.CreatedAt,
			Labelled:  len(issue.Labels) > 0,
			Mine:      issue.Author.Login == me,
		})
	}
	for _, pr := range prs {
		var ciFailing bool
		for _, check := range pr.StatusCheckRollup {
			if check.Conclusion == "FAILURE" || check.State == "FAILURE" || check.State == "ERROR" {
				ciFailing = true
			}
		}
		items = append(items, item{
			Kind:        kindPullRequest,
			Ref:         "#" + strconv.Itoa(pr.Number),
			Title:       pr.Title,
			URL:         pr.URL,
			CreatedAt:   pr.CreatedAt,
			Labelled:    len(pr.Labels) > 0,
			Mine:        pr.Author.Login == me,
			Dependabot:  pr.Author.Login == "app/dependabot",
			Draft:       pr.IsDraft,
			Conflicting: pr.Mergeable == "CONFLICTING",
			CIFailing:   ciFailing,
			Size:        pr.Additions + pr.Deletions,
		})
	}
	for _, advisory := range advisories {
		if advisory.State != "triage" && advisory.State != "draft" {
			continue
		}
		items = append(items, item{
			Kind:      kindAdvisory,
			Ref:       advisory.GHSAID,
			Title:     advisory.Summary,
			URL:       advisory.HTMLURL,
			CreatedAt: advisory.CreatedAt,
			Severity:  advisory.Severity,
		})
	}
	return items, nil
}

var githubMe = sync.OnceValues(func() (string, error) {
	out, err := exec.Command("gh", "api", "user", "--jq", ".login").Output()
	if err != nil {
		return "", fmt.Errorf("gh api user: %w", err)
	}
	return strings.TrimSpace(string(out)), nil
})

type githubItem struct {
	Number    int        `json:"number"`
	Title     string     `json:"title"`
	URL       string     `json:"url"`
	Labels    []struct{} `json:"labels"`
	CreatedAt time.Time  `json:"createdAt"`
	Author    struct {
		Login string `json:"login"`
	} `json:"author"`
	IsDraft           bool   `json:"isDraft"`
	Mergeable         string `json:"mergeable"`
	StatusCheckRollup []struct {
		Conclusion string `json:"conclusion"`
		State      string `json:"state"`
	} `json:"statusCheckRollup"`
	Additions int `json:"additions"`
	Deletions int `json:"deletions"`
}

type githubAdvisory struct {
	GHSAID    string    `json:"ghsa_id"`
	Summary   string    `json:"summary"`
	HTMLURL   string    `json:"html_url"`
	State     string    `json:"state"`
	Severity  string    `json:"severity"`
	CreatedAt time.Time `json:"created_at"`
}

func githubJSON(dest any, args ...string) error {
	cmd := exec.Command("gh", args...)
	cmd.Stderr = os.Stderr
	out, err := cmd.Output()
	if err != nil {
		return fmt.Errorf("gh %s: %w", strings.Join(args[:2], " "), err)
	}
	if err := json.Unmarshal(out, dest); err != nil {
		return fmt.Errorf("decode gh %s: %w", strings.Join(args[:2], " "), err)
	}
	return nil
}
