#!/usr/bin/env fish

function relative-duration -a secs parts
    set -l out
    for unit in 86400/d 3600/h 60/m 1/s
        set -l div (string split / $unit)
        test "$secs" -ge "$div[1]"; or test "$div[1]" -eq 1 -a -z "$out"
        or continue

        set -a out (math -s0 "$secs / $div[1]")$div[2]
        set secs (math "$secs % $div[1]")
        test (count $out) -lt "$parts"; or break
    end
    echo $out
end

set parts 1
set -q argv[2]; and set parts $argv[2]

if set -q argv[1]; and test "$argv[1]" != -
    relative-duration $argv[1] $parts
else
    while read -l secs
        relative-duration $secs $parts
    end
end
