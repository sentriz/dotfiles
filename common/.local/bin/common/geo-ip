///bin/true; exec go-script "$0" "$@"
// vi: ft=go

package main

import (
	"bufio"
	"bytes"
	"compress/gzip"
	"database/sql"
	"encoding/csv"
	"errors"
	"fmt"
	"io"
	"net/http"
	"net/netip"
	"net/url"
	"os"
	"path/filepath"
	"strings"

	_ "github.com/ncruces/go-sqlite3/driver"
)

func main() {
	cacheDir, err := os.UserCacheDir()
	cerr(err)

	var dbURI url.URL
	dbURI.Scheme = "file"
	dbURI.Path = filepath.Join(cacheDir, "dbip-city-v4-v6.db")
	db, err := sql.Open("sqlite3", dbURI.String())
	cerr(err)
	defer db.Close()

	_, err = db.Exec(`
		create table if not exists ip_locs (
			ip_start  blob primary key,
			ip_end    blob not null,
			country   text,
			state1    text,
			state2    text,
			city      text,
			postcode  text
		);
	`)
	cerr(err)

	err = ensureDB(db)
	cerr(err)

	var r io.Reader = os.Stdin
	if len(os.Args) > 1 {
		var buff bytes.Buffer
		for _, arg := range os.Args[1:] {
			fmt.Fprintln(&buff, arg)
		}
		r = &buff
	}

	for sc := bufio.NewScanner(r); sc.Scan(); {
		ipStr := strings.TrimSpace(sc.Text())

		addr, err := netip.ParseAddr(ipStr)
		cerr(err)

		ip := addr.As16()

		var country, state1, state2, city, postcode string
		err = db.QueryRow("select country, state1, state2, city, postcode from (select * from ip_locs where ip_start <= ? order by ip_start desc limit 1) where ip_end >= ?;", ip[:], ip[:]).Scan(&country, &state1, &state2, &city, &postcode)
		if errors.Is(err, sql.ErrNoRows) {
			fmt.Printf("%s\t%s\t%s\t%s\t%s\t%s\n", ipStr, "", "", "", "", "")
			continue
		}
		cerr(err)

		fmt.Printf("%s\t%s\t%s\t%s\t%s\t%s\n", ipStr, country, state1, state2, city, postcode)
	}
}

var ipsURLs = []string{
	`https://github.com/sapics/ip-location-db/releases/download/latest/dbip-city-ipv4.csv.gz`,
	`https://github.com/sapics/ip-location-db/releases/download/latest/dbip-city-ipv6.csv.gz`,
}

func ensureDB(db *sql.DB) error {
	{
		var c int
		if err := db.QueryRow("select 1 from ip_locs limit 1;").Scan(&c); err != nil && !errors.Is(err, sql.ErrNoRows) {
			return fmt.Errorf("scan size: %w", err)
		}
		if c != 0 {
			return nil
		}
	}

	tx, err := db.Begin()
	if err != nil {
		return fmt.Errorf("begin: %w", err)
	}
	defer tx.Rollback()

	stmt, err := tx.Prepare(`insert into ip_locs values (?, ?, ?, ?, ?, ?, ?)`)
	if err != nil {
		return fmt.Errorf("prepare: %w", err)
	}
	defer stmt.Close()

	for _, ipsURL := range ipsURLs {
		if err := insertCSV(stmt, ipsURL); err != nil {
			return fmt.Errorf("insert %s: %w", ipsURL, err)
		}
	}

	if err := tx.Commit(); err != nil {
		return fmt.Errorf("commit: %w", err)
	}

	return nil
}

func insertCSV(stmt *sql.Stmt, ipsURL string) error {
	resp, err := http.Get(ipsURL)
	if err != nil {
		return fmt.Errorf("get: %w", err)
	}
	defer resp.Body.Close()

	gr, err := gzip.NewReader(resp.Body)
	if err != nil {
		return fmt.Errorf("new gz: %w", err)
	}
	defer gr.Close()

	cr := csv.NewReader(gr)
	for {
		row, err := cr.Read()
		if errors.Is(err, io.EOF) {
			return nil
		}
		if err != nil {
			return fmt.Errorf("read csv: %w", err)
		}

		start, err := netip.ParseAddr(row[0])
		if err != nil {
			return fmt.Errorf("parse start: %w", err)
		}
		end, err := netip.ParseAddr(row[1])
		if err != nil {
			return fmt.Errorf("parse end: %w", err)
		}
		startIP, endIP := start.As16(), end.As16()

		if _, err := stmt.Exec(startIP[:], endIP[:], row[2], row[3], row[4], row[5], row[6]); err != nil {
			return fmt.Errorf("exec: %w", err)
		}
	}
}

func cerr(err error) {
	if err != nil {
		panic(err)
	}
}
