#!/usr/bin/env bash

set -eu

url="https://speed.cloudflare.com"
secs=5

down() {
    measure down curl -sfo /dev/null -m "$secs" -w '%{speed_download}' "$url/__down?bytes=99999999"
}

up() {
    measure up curl -sfo /dev/null -m "$secs" -w '%{speed_upload}' -X POST -T - "$url/__up" </dev/zero
}

measure() {
    local b
    b="$("${@:2}" || test $? -eq 28)"
    awk -v m="$1" -v b="$b" 'BEGIN { printf "%s\t%.1f Mbit/s\n", m, b * 8 / 1e6 }'
}

ping() {
    local ms
    ms="$(
        for _ in 1 2 3 4 5; do
            curl -sSfo /dev/null -w '%{time_pretransfer} %{time_starttransfer}\n' "$url/__down?bytes=0"
        done | awk '{ print ($2 - $1) * 1000 }' | sort -n | sed -n 3p
    )"
    printf "ping\t%.0f ms\n" "$ms"
}

test $# -eq 0 && set -- down up ping

for m in "$@"; do
    case "$m" in
    down | up | ping) "$m" ;;
    *) exit 1 ;;
    esac
done
