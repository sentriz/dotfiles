#!/usr/bin/env bash

set -euo pipefail

url="https://speed.cloudflare.com"
secs=10

down() {
    measure down curl -fo /dev/null -m "$secs" -w '\n%{speed_download}\n' "$url/__down?bytes=99999999"
}

up() {
    measure up curl -fo /dev/null -m "$secs" -w '\n%{speed_upload}\n' -X POST -T - "$url/__up" </dev/zero
}

measure() {
    { "${@:2}" 2>&1 || test $? -eq 28; } | awk -v RS='[\r\n]' -v m="$1" '
        NF == 1 { printf "\r\033[K" > "/dev/stderr"; printf "%s\t%.1f Mbit/s\n", m, $1 * 8 / 1e6 }
        NF > 1 && $1 ~ /^[0-9]+$/ { printf "\r%s\t%.1f Mbit/s\033[K", m, bytes($NF) * 8 / 1e6 > "/dev/stderr" }
        function bytes(s) { return s * 1024 ^ index("kMGTP", substr(s, length(s))) }'
}

ping() {
    local ms
    ms="$(
        for _ in 1 2 3 4 5; do
            curl -sSfo /dev/null -w '%{time_pretransfer} %{time_starttransfer}\n' "$url/__down?bytes=0"
        done | awk '{ print ($2 - $1) * 1000 }' | sort -n | sed -n 3p
    )"
    printf "ping\t%.0f ms\n" "$ms"
}

test $# -eq 0 && set -- down up ping

for m in "$@"; do
    case "$m" in
    down | up | ping) "$m" ;;
    *) exit 1 ;;
    esac
done
