///bin/true; exec go-script "$0" "$@"
// vi: ft=go

package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"strings"

	"github.com/BurntSushi/toml"
	"gopkg.in/yaml.v3"
)

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func run() error {
	userConfig, err := os.UserConfigDir()
	if err != nil {
		return fmt.Errorf("read user config: %w", err)
	}

	projectsListPath := filepath.Join(userConfig, "projects")
	projectsList, err := os.Open(projectsListPath)
	if err != nil {
		return fmt.Errorf("read projects list: %w", err)
	}
	defer projectsList.Close()

	projectsDir := os.Getenv("PROJECTS_DIR")
	if projectsDir == "" {
		return fmt.Errorf("PROJECTS_DIR not set")
	}

	out := bufio.NewWriter(os.Stdout)
	defer out.Flush()

	enc := json.NewEncoder(out)
	sc := bufio.NewScanner(projectsList)
	for sc.Scan() {
		if sc.Text() == "" {
			continue
		}

		projectPath := filepath.Join(projectsDir, sc.Text())

		var dest = map[string]any{"path": projectPath}
		for _, sn := range sniffers {
			var found []any
			for _, pattern := range sn.patterns {
				paths, err := filepath.Glob(filepath.Join(globEscape(projectPath), pattern))
				if err != nil {
					return fmt.Errorf("glob %s: %w", pattern, err)
				}

				for _, path := range paths {
					data, err := os.ReadFile(path)
					if err != nil {
						return fmt.Errorf("read %s: %w", path, err)
					}

					parsed, err := sn.parse(path, data)
					if err != nil {
						return fmt.Errorf("parse %s: %w", path, err)
					}

					found = append(found, parsed)
				}
			}
			dest[sn.key] = found
		}

		if err := enc.Encode(dest); err != nil {
			return fmt.Errorf("enc: %w", err)
		}
	}
	if err := sc.Err(); err != nil {
		return fmt.Errorf("read projects list: %w", err)
	}

	return nil
}

type sniffer struct {
	key      string
	patterns []string
	parse    func(path string, data []byte) (any, error)
}

var sniffers = []sniffer{
	{
		key:      "actions",
		patterns: []string{".github/workflows/*.yml", ".github/workflows/*.yaml"},
		parse: func(path string, data []byte) (any, error) {
			type Use struct {
				Action  string         `json:"action"`
				Version string         `json:"version"`
				With    map[string]any `json:"with"`
			}
			type Workflow struct {
				Path string `json:"path"`
				Name string `json:"name"`
				Uses []Use  `json:"uses"`
			}

			var doc struct {
				Name string `yaml:"name"`
				Jobs map[string]struct {
					Steps []struct {
						Uses string         `yaml:"uses"`
						With map[string]any `yaml:"with"`
					} `yaml:"steps"`
				} `yaml:"jobs"`
			}
			if err := yaml.Unmarshal(data, &doc); err != nil {
				return nil, err
			}

			workflow := Workflow{Path: path, Name: doc.Name}
			for _, job := range doc.Jobs {
				for _, step := range job.Steps {
					if step.Uses == "" {
						continue
					}
					action, version, _ := strings.Cut(step.Uses, "@")
					workflow.Uses = append(workflow.Uses, Use{Action: action, Version: version, With: step.With})
				}
			}
			return workflow, nil
		},
	},
	{
		key:      "dependabot",
		patterns: []string{".github/dependabot.yml", ".github/dependabot.yaml"},
		parse: func(path string, data []byte) (any, error) {
			type Update struct {
				Ecosystem string `json:"ecosystem" yaml:"package-ecosystem"`
				Directory string `json:"directory" yaml:"directory"`
			}
			type Dependabot struct {
				Path    string   `json:"path"    yaml:"-"`
				Updates []Update `json:"updates" yaml:"updates"`
			}

			var dependabot Dependabot
			if err := yaml.Unmarshal(data, &dependabot); err != nil {
				return nil, err
			}
			dependabot.Path = path
			return dependabot, nil
		},
	},
	{
		key:      "docker",
		patterns: []string{"Dockerfile", "*/Dockerfile"},
		parse: func(path string, data []byte) (any, error) {
			type Dockerfile struct {
				Path   string   `json:"path"`
				Stages []string `json:"stages"`
			}

			dockerfile := Dockerfile{Path: path}
			for line := range strings.Lines(string(data)) {
				cmd, rest, ok := strings.Cut(line, " ")
				if !ok || strings.ToUpper(cmd) != "FROM" {
					continue
				}

				for t := range strings.FieldsSeq(rest) {
					if strings.HasPrefix(t, "--") {
						continue
					}
					dockerfile.Stages = append(dockerfile.Stages, t)
					break
				}
			}
			return dockerfile, nil
		},
	},
	{
		key:      "go",
		patterns: []string{"go.mod", "*/go.mod"},
		parse: func(path string, data []byte) (any, error) {
			type Module struct {
				Path      string `json:"path"`
				Go        string `json:"go"`
				Toolchain string `json:"toolchain"`
			}

			module := Module{Path: path}
			for line := range strings.Lines(string(data)) {
				cmd, rest, ok := strings.Cut(line, " ")
				if !ok {
					continue
				}
				switch cmd {
				case "go":
					module.Go = strings.TrimSpace(rest)
				case "toolchain":
					module.Toolchain = strings.TrimSpace(rest)
				}
			}
			return module, nil
		},
	},
	{
		key:      "npm",
		patterns: []string{"package.json", "*/package.json"},
		parse: func(path string, data []byte) (any, error) {
			type Package struct {
				Path    string            `json:"path"`
				Name    string            `json:"name"`
				Version string            `json:"version"`
				Scripts map[string]string `json:"scripts"`
			}

			var pkg Package
			if err := json.Unmarshal(data, &pkg); err != nil {
				return nil, err
			}
			pkg.Path = path
			return pkg, nil
		},
	},
	{
		key:      "uv",
		patterns: []string{"pyproject.toml", "*/pyproject.toml"},
		parse: func(path string, data []byte) (any, error) {
			type Project struct {
				Path           string `json:"path"            toml:"-"`
				Name           string `json:"name"            toml:"name"`
				Version        string `json:"version"         toml:"version"`
				RequiresPython string `json:"requires_python" toml:"requires-python"`
			}

			var doc struct {
				Project Project `toml:"project"`
			}
			if _, err := toml.Decode(string(data), &doc); err != nil {
				return nil, err
			}
			doc.Project.Path = path
			return doc.Project, nil
		},
	},
}

func globEscape(path string) string {
	var r strings.Builder
	for _, c := range path {
		switch c {
		case '*', '?', '[':
			r.WriteRune('[')
			r.WriteRune(c)
			r.WriteRune(']')
		default:
			r.WriteRune(c)
		}
	}
	return r.String()
}
