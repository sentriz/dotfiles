Include config.local config.secrets

Host sam*
    HostName sam.senan.internal
    User senan
    ServerAliveInterval 2
    ServerAliveCountMax 4

Host laptop*
    HostName laptop.senan.internal
    User senan
    ForwardAgent yes

Host phone
    HostName phone.senan.internal
    User u0_a216
    Port 8022

Host raspberrypi
    HostName raspberrypi.senan.internal
    User pi

Host glkvm
    HostName glkvm.senan.internal
    User root

Host tayne
    HostName 192.168.1.1
    User root

Host gate*
    HostName gate.senan.internal
    User senan
    ServerAliveInterval 2
    ServerAliveCountMax 4

Host *-interactive
    ExitOnForwardFailure yes
    StreamLocalBindUnlink yes
    Compression yes
    ForwardAgent yes
    RequestTTY force
    RemoteCommand SHELL=/usr/bin/fish tmux new -A -s default
