Include config.local config.secrets

Host *
    HashKnownHosts yes

Host sam*
    HostName sam.ts.senan.xyz
    User senan
    ServerAliveInterval 2
    ServerAliveCountMax 4

Host laptop*
    HostName laptop.ts.senan.xyz
    User senan
    ForwardAgent yes

Host phone
    HostName phone.ts.senan.xyz
    User u0_a216
    Port 8022

Host raspberrypi
    HostName raspberrypi.ts.senan.xyz
    User pi

Host glkvm
    HostName glkvm.ts.senan.xyz
    User root

Host tayne
    HostName 192.168.1.1
    User root

Host gate*
    HostName gate.ts.senan.xyz
    User senan
    ServerAliveInterval 2
    ServerAliveCountMax 4

Host *-interactive
    ExitOnForwardFailure yes
    StreamLocalBindUnlink yes
    Compression yes
    ForwardAgent yes
    RequestTTY force
    RemoteCommand SHELL=/usr/bin/fish tmux new -A -s default
