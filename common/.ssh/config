Include config.local

Host sam*
    HostName sam
    User senan
    ServerAliveInterval 2
    ServerAliveCountMax 4

Host sam-interactive
    ExitOnForwardFailure yes
    Compression yes
    ForwardAgent yes
    RequestTTY force
    RemoteCommand SHELL=/usr/bin/fish tmux new -A -s default

Host laptop
    HostName laptop
    User senan
    ForwardAgent yes

Host phone
    HostName phone
    User u0_a216
    Port 8022

Host raspberrypi
    HostName raspberrypi
    User pi
