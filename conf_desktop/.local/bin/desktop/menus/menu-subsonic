#!/usr/bin/env bash

set -u

pidfile="$XDG_RUNTIME_DIR/menu-subsonic.pid"

base="$(secret gonic_url)"
user="$(secret gonic_username)"
salt="$RANDOM$RANDOM$RANDOM"
token="$(printf '%s%s' "$(secret gonic_password)" "$salt" | md5sum | cut -d' ' -f1)"

auth=(-d v=1.16.1 -d c=cmenu -d f=json --data-urlencode "u=$user" --data-urlencode "s=$salt" --data-urlencode "t=$token")

api() {
    local endpoint="$1" args=() param
    shift
    for param in "$@"; do args+=(--data-urlencode "$param"); done
    curl -fsG "$base/rest/$endpoint" "${auth[@]}" "${args[@]}" | jq -r '."subsonic-response"'
}

stream-url() {
    printf '%s/rest/stream?v=1.16.1&c=cmenu&u=%s&s=%s&t=%s&id=%s' "$base" "$user" "$salt" "$token" "$1"
}

song-ids() {
    local kind="$1" id="$2"
    case "$kind" in
    song) printf '%s\n' "$id" ;;
    album) api getAlbum "id=$id" | jq -r '.album.song[].id' ;;
    artist) api getTopSongs "id=$id" count=50 | jq -r '.topSongs.song[]?.id' ;;
    esac
}

if [[ "${CMENU_MODE-}" = "preview" ]]; then
    IFS=$'\t' read -r payload _ <<<"$1"
    IFS=: read -r _ cover _ <<<"$payload"
    [[ -z "$cover" ]] && exit 0

    curl -fsG "$base/rest/getCoverArt" "${auth[@]}" --data-urlencode "id=$cover" -d size=600 | cmenu image -
    exit 0
fi

current_pid="" current_id=""
[[ -f "$pidfile" ]] && IFS=$'\t' read -r current_pid current_id <"$pidfile"
if [[ -n "$current_pid" ]] && ! kill -0 "$current_pid" 2>/dev/null; then
    current_pid=""
    current_id=""
    rm -f "$pidfile"
fi

if [[ "$#" -gt 0 ]]; then
    IFS=$'\t' read -r payload kind _ title _ <<<"$1"
    IFS=: read -r id _ <<<"$payload"

    if [[ -n "$current_pid" ]]; then
        kill "$current_pid" 2>/dev/null
        while kill -0 "$current_pid" 2>/dev/null; do sleep 0.1; done
        rm -f "$pidfile"
        [[ "$id" = "$current_id" ]] && exit
    fi

    urls=()
    while read -r song; do urls+=("$(stream-url "$song")"); done < <(song-ids "$kind" "$id")
    [[ "${#urls[@]}" -eq 0 ]] && exit

    mpv --no-ytdl --no-video --quiet --no-resume-playback "${urls[@]}" &
    echo -e "$!\t$id" >"$pidfile"
    notify-send 'started playing' "$title"

    exit
fi

jq_args=(-r --arg hl "$(cmenu highlight)" --arg cur "$current_id")
# shellcheck disable=SC2016
jq_row='def row(kind; year; title; artist):
    "\(if .id == $cur then $hl else "" end)\(.id):\(.coverArt // "")\t\(kind)\t\(year)\t\(title)\t\(artist)";'

cmenu set \
    colour 6 \
    preview true \
    stay_open true \
    hide 1 \
    debounce 300ms

if [[ -n "${CMENU_INPUT-}" ]]; then
    api search3 "query=${CMENU_INPUT-}" artistCount=10 albumCount=20 songCount=20 | jq "${jq_args[@]}" "$jq_row"'
        .searchResult3 // {} |
        (.artist[]? | row("artist"; "-"; .name; "")),
        (.album[]?  | row("album"; .year // "-"; .name; .artist)),
        (.song[]?   | row("song"; .year // "-"; .title; .artist))
    '
else
    api getAlbumList2 type=newest size=50 | jq "${jq_args[@]}" "$jq_row"'
        .albumList2.album[]? | row("album"; .year // "-"; .name; .artist)
    '
fi
