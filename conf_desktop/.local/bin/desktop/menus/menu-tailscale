#!/usr/bin/env bash

if [[ "$#" -gt 0 ]]; then
    IFS=$'\t' read -r _ cmd _ <<<"$1"
    read -ra cmd <<<"$cmd"
    tailscale "${cmd[@]}"
    exit
fi

label="$(cmenu label)"
highlight="$(cmenu highlight)"

status="$(tailscale status --json)"

health="$(jq -r '.Health[]?' <<<"$status")"
if [[ -n "$health" ]]; then
    while read -r line; do
        line="${line%.}"
        printf '%s%s\n' "$label" "${line,,}"
    done <<<"$health"
else
    printf '%shealthy\n' "$label"
fi

if [[ "$(jq -r '.BackendState' <<<"$status")" == "Running" ]]; then
    printf '%s%s\t%s\n' "$highlight" connected down
else
    printf '%s\t%s\n' connect up
fi

if [[ "$(tailscale debug prefs | jq -r '.RouteAll')" == "true" ]]; then
    printf '%saccept routes\t%s\n' "$highlight" "set --accept-routes=false"
else
    printf '%s\t%s\n' "accept routes" "set --accept-routes"
fi

jq -r '.Peer[]? | select(.ExitNodeOption) | [.ExitNode, .HostName, .TailscaleIPs[0]] | @tsv' <<<"$status" \
    | while IFS=$'\t' read -r active host ip; do
        if [[ "$active" == "true" ]]; then
            printf '%sexit node\t%s\t%s\n' "$highlight" "set --exit-node=" "$host"
        else
            printf 'exit node\t%s\t%s\n' "set --exit-node=$ip" "$host"
        fi
    done

jq -r '.Peer[]? | [.HostName, (if .Online then "online" else "offline" end), .OS, .RxBytes, .TxBytes] | @tsv' <<<"$status" \
    | sort \
    | while IFS=$'\t' read -r host online os rx tx; do
        printf '%speer %s %s %s rx %s tx %s\n' "$label" "$host" "$online" "${os,,}" \
            "$(numfmt --to=iec <<<"$rx")" "$(numfmt --to=iec <<<"$tx")"
    done
