#!/usr/bin/env bash

if [[ "$#" -gt 0 ]]; then
    IFS=$'\t' read -r _ id <<<"$1"
    case "$id" in
    lock) swaylock ;;
    exit) swaymsg exit ;;
    reload) swaymsg reload ;;
    esac
    exit
fi

data="$(cmenu data)"

printf '%s%s%s\n' \
    "lock screen" "$data" lock \
    "exit sway" "$data" exit \
    "reload config" "$data" reload
