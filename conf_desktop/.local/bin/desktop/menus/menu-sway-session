#!/usr/bin/env bash

set -u

if [[ "$#" -gt 0 ]]; then
    readarray -td $'\t' f < <(printf '%s' "$1")
    id="${f[1]}"
    case "$id" in
    lock) swaylock ;;
    exit) swaymsg exit ;;
    reload) swaymsg reload ;;
    esac
    exit
fi

data="$(cmenu data)"

printf '%s\t%s%s\n' \
    "lock screen" "$data" lock \
    "exit sway" "$data" exit \
    "reload config" "$data" reload
