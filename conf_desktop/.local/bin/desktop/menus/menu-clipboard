#!/usr/bin/env bash

IFS=$'\t' read -r text id <<<"$1"

if [[ "$CMENU_MODE" = "preview" ]]; then
    if [[ "$text" != "[[ binary data "*" ]]" ]]; then
        cliphist decode "$id"
    elif [[ "$text" =~ [0-9]+x[0-9]+\ \]\]$ ]]; then
        cliphist decode "$id" | cmenu image -
    fi
    exit 0
fi

if [[ "$#" -gt 0 ]]; then
    cliphist decode "$id" | wl-copy
    exit
fi

mapfile -t rows < <(cliphist list)
[[ "${#rows[@]}" -eq 0 ]] && exit 0

pre=""
cmp -s <(cliphist decode <<<"${rows[0]}") <(wl-paste -n 2>/dev/null) && pre="$(cmenu highlight)"

printf '%s\n' "${rows[@]}" \
    | awk -F'\t' -v d="$(cmenu data)" -v hl="$pre" '{ id = $1; sub(/^[^\t]*\t/, ""); printf "%s%s%s%s\n", (NR == 1 ? hl : ""), $0, d, id }'
