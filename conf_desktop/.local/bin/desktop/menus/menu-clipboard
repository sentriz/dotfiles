#!/usr/bin/env bash

readarray -td $'\t' f < <(printf '%s' "$1")
text="${f[0]}" id="${f[1]}"

if [[ "$CMENU_MODE" = "preview" ]]; then
    if [[ "$text" != "[[ binary data "*" ]]" ]]; then
        cliphist decode "$id"
    elif [[ "$text" =~ [0-9]+x[0-9]+\ \]\]$ ]]; then
        cliphist decode "$id" | cmenu image -
    fi
    exit 0
fi

if [[ "$#" -gt 0 ]]; then
    cliphist decode "$id" | wl-copy
    exit
fi

newest_id="$(cliphist list | head -1 | cut -f1)"
[[ -z "$newest_id" ]] && exit 0

# the newest entry is the clipboard, unless something has copied or cleared it since
current_id=""
cmp -s <(cliphist decode "$newest_id") <(wl-paste -n 2>/dev/null) && current_id="$newest_id"

cliphist list \
    | awk -F'\t' -v d="$(cmenu data)" -v hl="$(cmenu highlight)" -v cur="$current_id" \
        '{ id = $1; sub(/^[^\t]*\t/, ""); printf "%s%s%s%s\n", (id == cur ? hl : ""), $0, d, id }'
