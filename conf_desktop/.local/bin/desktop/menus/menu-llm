#!/usr/bin/env bash

if [[ "$#" -gt 0 ]]; then
    wl-copy -n <<<"$1"
    exit
fi

if [[ -z "$CMENU_INPUT" ]]; then
    echo "$(cmenu label)no input"
    exit
fi

pi \
    --model openai/gpt-5.6-luna \
    --no-tools \
    --no-prompt-templates \
    --no-context-files \
    --no-skills \
    --no-extensions \
    --session-dir "$XDG_RUNTIME_DIR/pi/menu-llm-sessions" \
    --session-id "menu-llm-$PPID" \
    --system-prompt "Answer concisely in plain text only. No markdown, no latex." \
    --print "$CMENU_INPUT" \
    | awk -v label="$(cmenu label)" 'NF { print; next } { print label }'
exit 0
