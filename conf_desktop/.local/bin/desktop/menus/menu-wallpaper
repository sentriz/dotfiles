#!/usr/bin/env bash

set -u

wallpapers="$XDG_PICTURES_DIR/wallpapers"

if [[ "${CMENU_MODE-}" = "preview" ]]; then
    cmenu image "$wallpapers/$1"
    exit 0
fi

if [[ "$#" -gt 0 ]]; then
    swaymsg output '*' bg "$wallpapers/$1" fill
    exit
fi

find "$wallpapers" -maxdepth 1 -type f -printf '%f\n' | sort
