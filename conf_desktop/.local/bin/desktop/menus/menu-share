#!/usr/bin/env bash

set -u

if [[ "${CMENU_MODE-}" = "preview" ]]; then
    IFS=$'\t' read -r mime _ _ source <<<"$1"

    path="$(current-files resolve "$source" "$mime")"
    [[ -n "$path" ]] || exit 0

    case "$mime" in
    image/png | image/jpeg | image/gif | image/webp | image/bmp | image/tiff) cmenu image "$path" ;;
    text/* | application/json) head -c 100000 "$path" ;;
    *) printf '%s\t%s\n' type "$mime" size "$(du -h "$path" | cut -f1)" | table ;;
    esac
    exit 0
fi

if [[ "$#" -gt 0 ]]; then
    IFS=$'\t' read -r mime _ dest source <<<"$1"

    if ! path="$(current-files resolve "$source" "$mime")"; then
        notify-send "share failed" "$source is gone"
        exit 0
    fi

    if ! url="$(share "$dest" "$path")"; then
        notify-send "share failed" "$dest"
        exit 0
    fi
    [[ -n "$url" ]] || exit 0

    wl-copy "$url"

    notify-send "shared" "$url"

    exit
fi

cmenu set \
    colour 3 \
    preview true \
    hide 4

while IFS=$'\t' read -r _ mime source; do
    label="$source"
    [[ -f "$source" ]] && label="$(basename "$(dirname "$source")")/$(basename "$source")"

    for dest in $(share list "$mime"); do
        printf '%s\t%s\t%s\t%s\n' "$mime" "$label" "$dest" "$source"
    done
done < <(current-files)
