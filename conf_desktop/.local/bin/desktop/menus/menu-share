#!/usr/bin/env bash

current_file() {
    mime="$(wl-paste -l 2>/dev/null | head -n 1)"
    case "$mime" in
    text/uri-list)
        path="$(wl-paste --type text/uri-list 2>/dev/null | head -n 1)"
        path="${path#file://}"
        if [[ -f "$path" ]]; then
            printf '%s\t%s\n' "clipboard-uri" "$(file --mime-type -b "$path")"
            return
        fi
        ;;
    image/* | video/*)
        printf '%s\t%s\n' "clipboard-media" "$mime"
        return
        ;;
    esac

    path="$(find "$XDG_DOWNLOAD_DIR" "$SCREENSHOTS_DIR" "$RECORDINGS_DIR" -maxdepth 1 -type f -printf '%T@\t%p\n' 2>/dev/null \
        | sort -rn | head -1 | cut -f2)"
    if [[ -f "$path" ]]; then
        printf '%s\t%s\n' "$path" "$(file --mime-type -b "$path")"
        return
    fi
}

resolve_file() {
    case "$1" in
    clipboard-uri)
        wl-paste --type text/uri-list 2>/dev/null | head -n 1 | sed 's@^file://@@'
        ;;
    clipboard-media)
        extension="$(wl-paste --type "$2" 2>/dev/null | file -b --extension - | cut -d/ -f1)"
        path="$(mktemp "$XDG_RUNTIME_DIR/upload-XXX.$extension")"
        wl-paste --type "$2" >"$path"
        echo "$path"
        ;;
    *)
        echo "$1"
        ;;
    esac
}

if [[ "$CMENU_MODE" = "preview" ]]; then
    readarray -td $'\t' f < <(printf '%s' "$1")
    mime="${f[0]}" source="${f[3]}"

    path="$(resolve_file "$source" "$mime")"
    [[ -f "$path" ]] || exit 0

    case "$mime" in
    image/png | image/jpeg | image/gif | image/webp | image/bmp | image/tiff) cmenu image "$path" ;;
    text/* | application/json) head -c 100000 "$path" ;;
    *) printf '%s\t%s\n' type "$mime" size "$(du -h "$path" | cut -f1)" | table ;;
    esac
    exit 0
fi

if [[ "$#" -gt 0 ]]; then
    readarray -td $'\t' f < <(printf '%s' "$1")
    mime="${f[0]}" dest="${f[2]}" source="${f[3]}"

    path="$(resolve_file "$source" "$mime")"
    [[ -n "$path" ]] || exit 1

    url="$(share "$dest" "$path")" || exit 1
    [[ -n "$url" ]] || exit 0

    wl-copy "$url"

    notify-send "shared" "$url"

    exit
fi

IFS=$'\t' read -r source mime <<<"$(current_file)"
if [[ -n "$mime" ]]; then
    data="$(cmenu data)"

    label="$source"
    if [[ -f "$source" ]]; then
        label="$(basename "$(dirname "$source")")/$(basename "$source")"
    fi

    for dest in $(share list "$mime"); do
        printf '%s\t%s\t%s%s\n' "$mime" "$label" "$dest" "$data$source"
    done
fi
