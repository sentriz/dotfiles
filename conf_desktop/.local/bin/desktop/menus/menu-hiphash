#!/usr/bin/env bash

set -u

if [[ "$#" -gt 0 ]]; then
    readarray -td $'\t' f < <(printf '%s' "$1")
    name="${f[0]}" hash="${f[1]}" id="${f[2]}"
    case "$name" in
    "input")
        wl-copy -n <<<"$id"
        ;;
    *)
        wl-copy -n <<<"$hash"
        ;;
    esac

    exit
fi

inp="${CMENU_INPUT-}"
if [[ -z "$inp" ]]; then
    inp="$(wl-paste -n)"
fi
if [[ -z "$inp" ]]; then
    echo "$(cmenu label)no input"
    exit
fi

if [[ "$inp" =~ ^[0-9]+$ ]]; then
    hiphash -enc all "$inp" || echo "$(cmenu label)invalid input"
    exit 0
fi

hiphash "$inp" || echo "$(cmenu label)invalid input"
exit 0
