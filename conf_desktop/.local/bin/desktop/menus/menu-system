#!/usr/bin/env bash

set -u

why="menu-system: lid stay awake"

lid_kept_awake() {
    systemd-inhibit --list 2>/dev/null | grep -q "$why"
}

if [[ "$#" -gt 0 ]]; then
    readarray -td $'\t' f < <(printf '%s' "$1")
    id="${f[1]}"
    case "$id" in
    suspend) systemctl suspend ;;
    hibernate) systemctl hibernate ;;
    reboot) systemctl reboot ;;
    shutdown) systemctl poweroff ;;
    lid)
        if lid_kept_awake; then
            pkill -f "$why"
            while lid_kept_awake; do sleep 0.1; done
        else
            systemd-inhibit --what=handle-lid-switch --why="$why" sleep infinity &
            disown
            while ! lid_kept_awake; do sleep 0.1; done
        fi
        ;;
    esac
    exit
fi

highlight="$(cmenu highlight)"
stay="$(cmenu stay)"
data="$(cmenu data)"

lid_pre="$stay"
lid_kept_awake && lid_pre="$stay$highlight"

printf '%suptime %s\n' "$(cmenu label)" "$(uptime --pretty | sed 's/^up //')"
printf '%s%s%s\n' \
    suspend "$data" suspend \
    hibernate "$data" hibernate \
    reboot "$data" reboot \
    shutdown "$data" shutdown
printf '%s%s%s%s\n' "$lid_pre" "lid stay awake" "$data" lid
