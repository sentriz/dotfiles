#!/usr/bin/env bash

set -u

index_file="$XDG_RUNTIME_DIR/block_playing_index"

function index() {
    cat "$index_file" 2>/dev/null || echo 0
}

function mpris() {
    mpris-ctrl -player-index "$(index)" "$@"
}

if [[ "$#" -gt 0 ]]; then
    readarray -td $'\t' f < <(printf '%s' "$1")
    id="${f[1]}"
    case "$id" in
    player) tee "$index_file" <<<"$(($(index) + 1))" >/dev/null ;;
    *) mpris "$id" ;;
    esac
    block-up playing
    exit
fi

status="$(mpris)"
[[ -n "$status" ]] && printf '%s%s\n' "$(cmenu label)" "$status"

data="$(cmenu data)"

printf '%s\t%s%s\n' \
    play-pause "$data" play-pause \
    "next track" "$data" next \
    "previous track" "$data" previous \
    stop "$data" stop \
    "next player" "$data" player
