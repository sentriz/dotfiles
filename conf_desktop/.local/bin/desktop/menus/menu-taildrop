#!/usr/bin/env bash

set -u

if [[ "$#" -gt 0 ]]; then
    IFS=$'\t' read -r mime _ peer source <<<"$1"
    if [[ "$mime" == "get" ]]; then
        tailscale file get --conflict=rename "$XDG_DOWNLOAD_DIR" || notify-send "get failed"
        exit 0
    fi

    if ! path="$(current-files resolve "$source" "$mime")"; then
        notify-send "send failed" "$source is gone"
        exit 0
    fi

    if ! tailscale file cp "$path" "$peer:"; then
        notify-send "send failed" "$(basename "$path") to $peer"
        exit 0
    fi

    notify-send "sent" "$(basename "$path") to $peer"

    exit
fi

pending="$(tailscale debug localapi v0/files/ 2>/dev/null \
    | jq -r '(. // [])[] | [.Name, .Size] | @tsv' \
    | numfmt -d$'\t' --field=2 --to=iec \
    | awk -F'\t' '{ printf "%s%s %s", sep, $1, $2; sep = ", " }')"
[[ -n "$pending" ]] && printf 'get\t%s\n' "$pending"

peers="$(tailscale status --json | jq -r '
    select(.BackendState == "Running") | .Self.UserID as $user | .Peer[]?
    | select(.Online and .UserID == $user) | .DNSName | split(".")[0]')"
if [[ -z "$peers" ]]; then
    echo "$(cmenu label)no peers online"
    exit 0
fi

cmenu set \
    colour 14 \
    stay_open true \
    hide 4

while IFS=$'\t' read -r _ mime source; do
    label="$source"
    [[ -f "$source" ]] && label="$(basename "$(dirname "$source")")/$(basename "$source")"

    for peer in $peers; do
        printf '%s\t%s\t%s\t%s\n' "$mime" "$label" "$peer" "$source"
    done
done < <(current-files)
