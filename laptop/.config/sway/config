#################################################
##             my i3 config, 2016-             ##
#################################################
##  mod [a-z]           -> windows/position    ##
##  mod [i o p]         -> notifications       ##
##  mod [num row]       -> workspaces          ##
##  mod shift [num row] -> move to workspaces  ##
##  mod return          -> launch term         ##
##  mod backspace       -> dictate             ##
##  caps lock           -> launch cmenu        ##
#################################################

# var modifier
set $super Mod4
set $alt   Mod1

# var cmenu
set $cmenu_sock $XDG_RUNTIME_DIR/foot-cmenu.sock
set $cmenu      pidof -q cmenu || footclient -s $cmenu_sock --app-id cmenu cmenu

floating_modifier $super

set $default_gap 12
# theme: font /^set \$default_font (.*) \d+$/ font-size-system /(\d+)$/
set $default_font Source Code Pro 9

# theme-reload: swaymsg reload
# theme: background
set $colour_bg           #333333
# theme: background D9
set $colour_bg_alpha     #333333D9
# theme: accent
set $colour_accent       #7D87FF
# theme: urgent
set $colour_urgent       #FF6880
# theme: urgent 60
set $colour_urgent_alpha #FF688060
# theme: grey5
set $colour_inactive     #737373
# theme: grey2
set $colour_fg           #E5E5E5
# theme: grey7
set $colour_bg_light     #404040

# basic appearance
smart_borders on
smart_gaps off
default_border pixel 2
gaps inner $default_gap
gaps top   -$default_gap
gaps left  -$default_gap
gaps right -$default_gap
font $default_font
popup_during_fullscreen smart
focus_on_window_activation focus

# default horizonal tabbled but only if multiple windows
hide_edge_borders --i3 none
workspace_layout tabbed

# always borders for floating windows
for_window [floating] border full

# title
titlebar_border_thickness 0
titlebar_padding 2
for_window [all] title_format "┃ %title"

# window colours        border           background       text       indicator        child
client.focused          $colour_fg       $colour_fg       $colour_bg       $colour_fg       $colour_fg
client.focused_inactive $colour_accent   $colour_accent   $colour_bg       $colour_accent   $colour_accent
client.unfocused        $colour_inactive $colour_inactive $colour_fg       $colour_inactive $colour_inactive
client.urgent           $colour_urgent   $colour_urgent   $colour_bg_light $colour_urgent   $colour_urgent

# input
input * {
    xkb_layout ie
    xkb_options caps:none
    repeat_delay 150
    repeat_rate 100
}

input type:touchpad {
    pointer_accel 0.25
    dwt enabled
    tap enabled
}

# output
output * {
    scale 1

    bg $XDG_PICTURES_DIR/wallpapers/wallhaven-7j36j9-2256x1504.jpg fill
}

# output laptop lid close
bindswitch --reload --locked lid:on output eDP-1 disable
bindswitch --reload --locked lid:off output eDP-1 enable

# right bar
bar {
    font $default_font
    height 20
    status_command i3blocks
    status_padding 0
    tray_padding 0
    tray_output primary
    colors separator  $colour_bg_alpha
    colors background $colour_bg_alpha
    colors statusline $colour_fg
    #                         border           background       text
    colors focused_workspace  $colour_accent   $colour_accent   $colour_bg_light
    colors active_workspace   $colour_bg       $colour_bg       $colour_fg
    colors inactive_workspace $colour_bg_alpha $colour_bg_alpha $colour_fg
    colors urgent_workspace   $colour_urgent   $colour_urgent   $colour_bg_light
}

# bindings: window/float
bindsym $super+q     kill
bindsym $super+f     fullscreen toggle
bindsym $super+space floating toggle
bindsym $super+y     sticky toggle

# bindings: focus
bindsym $super+v focus parent
bindsym $super+b focus child
bindsym $super+h focus left
bindsym $super+j focus down
bindsym $super+k focus up
bindsym $super+l focus right

# bindings: layout
bindsym $super+z layout tabbed
bindsym $super+x layout splith
bindsym $super+c layout splitv
bindsym $super+n splith
bindsym $super+m splitv

# bindings: position
bindsym $super+Left  move left
bindsym $super+Down  move down
bindsym $super+Up    move up
bindsym $super+Right move right

bindsym $super+w move workspace to output up
bindsym $super+a move workspace to output left
bindsym $super+s move workspace to output down
bindsym $super+d move workspace to output right

bindsym $super+e workspace back_and_forth, move workspace to output up,    workspace back_and_forth, move workspace to output down
bindsym $super+r workspace back_and_forth, move workspace to output right, workspace back_and_forth, move workspace to output left

bindsym $super+1     workspace number 1
bindsym $super+2     workspace number 2
bindsym $super+3     workspace number 3
bindsym $super+4     workspace number 4
bindsym $super+5     workspace number 5
bindsym $super+6     workspace number 6
bindsym $super+7     workspace number 7
bindsym $super+8     workspace number 8
bindsym $super+9     workspace number 9
bindsym $super+0     workspace number 10

bindsym $super+Shift+1 move container to workspace number 1
bindsym $super+Shift+2 move container to workspace number 2
bindsym $super+Shift+3 move container to workspace number 3
bindsym $super+Shift+4 move container to workspace number 4
bindsym $super+Shift+5 move container to workspace number 5
bindsym $super+Shift+6 move container to workspace number 6
bindsym $super+Shift+7 move container to workspace number 7
bindsym $super+Shift+8 move container to workspace number 8
bindsym $super+Shift+9 move container to workspace number 9
bindsym $super+Shift+0 move container to workspace number 10

# floating windows
for_window [window_type="menu"]                                       floating enable
for_window [window_role="app"]                                        floating enable
for_window [window_role="pop-up"]                                     floating enable
for_window [window_role="task_dialog"]                                floating enable
for_window [window_type="dialog"]                                     floating enable
for_window [title="Preferences$"]                                     floating enable
for_window [title="- Sharing Indicator$"]                             floating enable
for_window [class="Anki"]                                             floating enable
for_window [title="Anki$"]                                            floating enable
for_window [app_id="electrum"]                                        floating enable
for_window [app_id="nm-connection-editor"]                            floating enable
for_window [app_id="wdisplays"]                                       floating enable
for_window [app_id="^blueman-"]                                       floating enable
for_window [title="^Figure 1$"]                                       floating enable
for_window [class="Blueman-manager"]                                  floating enable
for_window [class="Galculator"]                                       floating enable
for_window [class="Gui.py"]                                           floating enable
for_window [class="Mnemosyne"]                                        floating enable
for_window [class="Nm-connection-editor"]                             floating enable
for_window [class="Pavucontrol"]                                      floating enable
for_window [app_id="pavucontrol"]                                     floating enable
for_window [class="Qpaeq"]                                            floating enable
for_window [class="SimpleScreenRecorder"]                             floating enable
for_window [class="Woeusbgui"]                                        floating enable
for_window [class="electrum"]                                         floating enable
for_window [class="etcher"]                                           floating enable
for_window [class="feh"]                                              floating enable
for_window [class="^XEyes$"]                                          floating enable
for_window [title="^bobby$"]                                          floating enable
for_window [app_id="^xdg-desktop-portal-gtk$"]                        floating enable
for_window [app_id="^firefox$" title="^Firefox — Sharing Indicator$"] floating enable
for_window [app_id="^thunar$" title="File Operation Progress"]        floating enable
for_window [class="^Pinentry-gtk-2$"]                                 floating enable
for_window [app_id="^qjackctl$"]                                      floating enable
for_window [app_id="^Manjaro.manjaro-settings-manager$"]              floating enable
for_window [title="^Emulator$"]                                       floating enable
for_window [title="^Android Emulator"]                                floating enable
for_window [class="^vysor$"]                                          floating enable
for_window [app_id="^wev$"]                                           floating enable
for_window [app_id="^imv$"]                                           floating enable
for_window [title="is sharing your screen.$"]                         floating enable
for_window [app_id="^com.github.tchx84.Flatseal$"]                    floating enable
for_window [class="^QjackCtl$"]                                       floating enable
for_window [class="com.github.wwmm.easyeffects"]                      floating enable
for_window [app_id="^pinentry-qt$"]                                   floating enable
for_window [app_id="^valent$"]                                        floating enable
for_window [app_id="^librewolf$" title="^Extension: .*"]              floating enable
for_window [class="^Pinentry-gtk$"]                                   floating enable

# floating to prevent glitch
for_window [title="^wl-clipboard$"] floating enable, border none

# floating sticky
for_window [app_id="^dragon-drop$"]                     floating enable, sticky enable

for_window [app_id="^firefox$" title="Picture-in-Picture"] fullscreen enable, move container to workspace number 10
for_window [app_id="^firefox$" title="Firefox — Sharing Indicator"] kill

for_window [app_id="^librewolf$" title="Picture-in-Picture"] fullscreen enable, move container to workspace number 10
for_window [app_id="^librewolf$" title="LibreWolf — Sharing Indicator"] kill

# bindings: xf86
bindsym XF86AudioLowerVolume  exec wpctl set-volume @DEFAULT_SINK@   2%-    && block-up audio
bindsym XF86AudioRaiseVolume  exec wpctl set-volume @DEFAULT_SINK@   2%+    && block-up audio
bindsym XF86AudioMute         exec wpctl set-mute   @DEFAULT_SINK@   toggle && block-up audio
bindsym XF86AudioMicMute      exec wpctl set-mute   @DEFAULT_SOURCE@ toggle && block-up audio

# push to talk with print screen or right ctrl
bindsym --no-repeat           print           exec wpctl set-mute @DEFAULT_SOURCE@ 0 && block-up audio
bindsym --no-repeat --release print           exec wpctl set-mute @DEFAULT_SOURCE@ 1 && block-up audio
bindsym                       shift+print     exec wpctl set-mute @DEFAULT_SOURCE@ 0 && block-up audio
bindsym --no-repeat           control_r       exec wpctl set-mute @DEFAULT_SOURCE@ 0 && block-up audio
bindsym --no-repeat --release control_r       exec wpctl set-mute @DEFAULT_SOURCE@ 1 && block-up audio
bindsym                       shift+control_r exec wpctl set-mute @DEFAULT_SOURCE@ 0 && block-up audio

bindsym XF86MonBrightnessDown exec xbacklight -dec 5
bindsym XF86MonBrightnessUp   exec xbacklight -inc 5

bindsym XF86AudioPlay         exec mpris-ctrl play-pause && block-up playing
bindsym XF86AudioStop         exec mpris-ctrl stop       && block-up playing
bindsym XF86AudioNext         exec mpris-ctrl next       && block-up playing
bindsym XF86AudioPrev         exec mpris-ctrl previous   && block-up playing

# bindings: gestures
bindgesture swipe:3:right workspace next_on_output
bindgesture swipe:3:left  workspace prev_on_output
bindgesture swipe:4:right move container to workspace next_on_output
bindgesture swipe:4:left  move container to workspace prev_on_output

bindgesture swipe:3:up    exec sway-focus back
bindgesture swipe:3:down  exec $cmenu
bindgesture hold:3        fullscreen toggle

# bindings: programs
bindsym $super+return       exec footclient

# bindings: notifications
bindsym $super+i exec 'swaymsg -q "[urgent=latest] focus" || makoctl invoke'
bindsym $super+o exec makoctl restore
bindsym $super+p exec makoctl dismiss --all

# dictate
bindsym $super+BackSpace exec dictate-type

# cmenu
bindcode 66 exec $cmenu

# sway-focus
bindsym $super+grave exec sway-focus back

# autostarts
exec_always dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE SSH_AUTH_SOCK SECRETS_SOCK XDG_DATA_DIRS PATH
# theme: font /"(.*) \d+"/ font-size /(\d+)"/
exec_always 'gsettings set org.gnome.desktop.interface monospace-font-name "Source Code Pro 10"'

exec_always 'pkill -fx "foot --server"; pidwait -fx "foot --server"; exec foot --server'
exec_always 'pkill -f "^foot --server=$cmenu_sock"; pidwait -f "^foot --server=$cmenu_sock"; exec windowtolayer -l overlay -i all -k exclusive -a top,left,right -s 0x550 foot --server=$cmenu_sock -o initial-color-theme=light'
exec rbw-agent
exec secret daemon
exec 'secret wait && until pimsync daemon || [ $? -eq 74 ]; do sleep 60; done'

exec_always 'pkill kanshi; exec kanshi'
exec_always 'pkill mako; exec mako'

exec 'secret wait && exec last-dot-friends-notify'

exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec wl-paste --watch cliphist store
exec sway-rename-workspaces
exec sway-focus
exec wlsunset -l 52.8 -L -6.9 -t 3000

# theme: accent background 80 bryellow
exec_always 'pkill wlr-sunclock; exec wlr-sunclock -w 600 -a br -m "$default_gap,$default_gap,$default_gap,$default_gap" -s -n "#7D87FF" -o "#33333380" -u "#FFE031"'
