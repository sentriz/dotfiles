# theme-reload: makoctl reload
# theme: font /^font=(.*) \d+$/ font-size-system /(\d+)$/
font=Source Code Pro 10
# theme: background
background-color=#333333
# theme: grey2
text-color=#E5E5E5
# theme: accent
border-color=#7C86FF
# theme: accent
progress-color=over #7C86FF
border-size=2
# theme: gap /=(\d+)/
margin=16,0
# theme: gap /,(\d+)$/
outer-margin=0,16
width=400
height=350
anchor=top-right
sort=+time
default-timeout=6000
# maybe move to [urgency=critical] if this gets annoying over fullscreen
layer=overlay

[urgency=critical]
# theme: urgent
border-color=#FF637E
