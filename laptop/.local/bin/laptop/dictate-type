#!/usr/bin/env bash

# depends
#   - dictate
#   - wtype
#   - libnotify

# TODO: use wl-ime-type when more programs support text-input-v3 (it hangs with electron, chromium, firefox)

set -u

state="$XDG_RUNTIME_DIR/dictate.state"

notify() {
    notify-send -a dictate -t 0 -p -r "$id" "$@"
}

close() {
    notify-send -a dictate -t 1 -r "$id" dictate
}

pid=""
id=0
[[ -f "$state" ]] && { read -r pid; read -r id; } <"$state"

if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill -TERM "$pid"
    notify "dictate" "transcribing" >/dev/null
    exit
fi

exec 3< <(dictate)
pid=$!
id="$(notify "dictate" "listening")"
printf '%s\n%s\n' "$pid" "$id" >"$state"
trap 'rm -f "$state"' EXIT

words=0
while IFS= read -r -u 3 line; do
    wtype "$line "
    words=$((words + $(wc -w <<<"$line")))
    notify "dictate: $words words" "$line" >/dev/null
done

close
