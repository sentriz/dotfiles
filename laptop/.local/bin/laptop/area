#!/usr/bin/env bash

set -u

border=2
# theme: background 80 accent
style=(-b '#33333380' -c '#7D87FF')

case "${1-}" in
list)
    printf "%s\n" region monitor window
    ;;
region)
    slurp "${style[@]}" -f $'geo\t%x,%y %wx%h\n'
    ;;
monitor)
    slurp "${style[@]}" -o -f $'geo\t%x,%y %wx%h\n'
    ;;
window)
    swaymsg -t get_tree \
        | jq --argjson b $border -r '
            .. | select(.pid? and .visible?) | .rect as $r |
            "\($r.x + $b),\($r.y + $b) \($r.width - $b*2)x\($r.height - $b*2) \(.foreign_toplevel_identifier // "")"
        ' \
        | slurp "${style[@]}" -f $'geo\t%x,%y %wx%h\ntoplevel\t%l\n' \
        | grep -v $'^toplevel\t$'
    ;;
*)
    exit 1
    ;;
esac
