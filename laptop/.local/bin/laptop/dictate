#!/usr/bin/env bash

# depends
#   - pipewire (pw-record)
#   - whisper-cpp-git
#   - sox

set -eu

models="$XDG_DATA_HOME/whisper-models"
model="$models/tiny_en_acft_q8_0.bin"
vad="$models/ggml-silero-v5.1.2.bin"

# what the mic is captured as, and what raw pcm on stdin must be
sample_format="s16"
rate=16000
channels=1

if [ "${1-}" = "--format" ]; then
    printf '%s\t%s\t%s\n' "$sample_format" "$rate" "$channels"
    exit
fi

fetch() {
    local path="$1" url="$2"
    [[ -f "$path" ]] && return 0
    mkdir -p "$models"
    curl -L -o "$path" "$url"
}

committed=0

emit() {
    local silence="$1" bytes pending src duration cut text

    bytes="$(stat -c %s "$raw")"
    bytes=$((bytes - bytes % 2))
    pending=$((bytes - committed))
    ((pending > 16000)) || return 0

    tail -c "+$((committed + 1))" "$raw" | head -c "$pending" |
        sox -t raw -r 16000 -e signed -b 16 -c 1 - "$wav"

    src="$wav"
    if [[ "$silence" == 0 ]]; then
        committed=$((committed + pending))
    else
        duration="$(awk -v bytes="$pending" 'BEGIN { printf "%.2f", bytes / 32000 }')"
        cut="$(
            whisper-vad-speech-segments -np -vm "$vad" -f "$wav" 2>/dev/null |
                awk -v duration="$duration" -v silence="$silence" '
                    /^Speech segment/ { end = $NF / 100 }
                    END {
                        if (end == "" || duration - end < silence) exit
                        printf "%.2f", (end + 0.2 > duration) ? duration : end + 0.2
                    }
                '
        )"
        [[ -n "$cut" ]] || return 0

        sox "$wav" "$clip" trim 0 "$cut"
        src="$clip"
        committed=$((committed + $(awk -v cut="$cut" 'BEGIN { printf "%d", int(cut * 16000) * 2 }')))
    fi

    text="$(whisper-cli -m "$model" -l en --no-timestamps --no-prints -f "$src" 2>/dev/null |
        tr '\n' ' ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    if [[ -n "$text" && "$text" != \[*\] ]]; then
        printf '%s\n' "$text"
    fi
}

fetch "$model" "https://voiceinput.futo.org/VoiceInput/$(basename "$model")"
fetch "$vad" "https://huggingface.co/ggml-org/whisper-vad/resolve/main/$(basename "$vad")"

raw="$(mktemp "$XDG_RUNTIME_DIR/dictate.XXXXXX.raw")"
wav="${raw%.raw}.wav"
clip="${raw%.raw}.clip.wav"
trap 'rm -f "$raw" "$wav" "$clip"' EXIT

if [[ -p /dev/stdin || -f /dev/stdin ]]; then
    cat <&0 >"$raw" &
else
    pw-record --raw --format="$sample_format" --rate="$rate" --channels="$channels" "$raw" >/dev/null 2>&1 &
fi
rec=$!

recording=1
trap 'recording=0' INT TERM

while ((recording)) && kill -0 "$rec" 2>/dev/null; do
    if [[ -t 0 ]]; then
        if read -rsn1 -t 1 key && [[ "$key" == $'\e' ]]; then recording=0; fi
    else
        sleep 1 || true
    fi
    emit 0.8
done

kill -TERM "$rec" 2>/dev/null || true
wait "$rec" 2>/dev/null || true

emit 0
