#!/usr/bin/env bash

set -u

if [[ "$#" -gt 0 ]]; then
    IFS=$'\t' read -r _ cmd <<<"$1"
    read -ra cmd <<<"$cmd"
    "${cmd[@]}"
    exit
fi

cmenu set \
    colour 11 \
    hide 2

printf '%s\t%s\n' \
    "lock screen" swaylock \
    "exit sway" "swaymsg exit" \
    "reload config" "swaymsg reload"
