#!/usr/bin/env bash

set -u

if [[ "$#" -gt 0 ]]; then
    IFS=$'\t' read -r cmd _ <<<"$1"
    read -ra cmd <<<"$cmd"
    tailscale "${cmd[@]}"
    exit
fi

label="$(cmenu label)"
highlight="$(cmenu highlight)"

cmenu set \
    colour 6 \
    stay_open true \
    hide 1

status="$(tailscale status --json)"

backend="$(jq -r '.BackendState' <<<"$status")"

if [[ "$backend" == Running ]]; then
    jq -r '[.Health[]? | ascii_downcase | rtrimstr(".") | select(contains("advertising routes") | not)]
        | if length == 0 then ["healthy"] else sort end | .[]' <<<"$status" \
        | sed "s/^/$label\thealth\t/"
else
    printf '%s\thealth\t%s\n' "$label" "$(lower <<<"$backend")"
fi

tailscale switch --list \
    | awk 'NR > 1 { current = sub(/\*$/, "", $3); print $1 "\t" $2 "\t" $3 "\t" current }' \
    | while IFS=$'\t' read -r id name account current; do
        if [[ "$current" != 1 ]]; then
            printf 'switch %s\ttailnet\t%s\t%s\n' "$id" "$name" "$account"
        elif [[ "$backend" == Running ]]; then
            printf '%sdown\ttailnet\t%s\t%s\n' "$highlight" "$name" "$account"
        else
            printf 'up\ttailnet\t%s\t%s\n' "$name" "$account"
        fi
    done

read -r corp_dns route_all has_exit_node lan_access < <(
    tailscale debug prefs | jq -r '[.CorpDNS, .RouteAll, .ExitNodeID != "", .ExitNodeAllowLANAccess] | join(" ")')

dns_upstream="$(tailscale dns status --json 2>/dev/null | jq -r '
    [(.Resolvers[0].Addr // empty | sub("^[a-z]+://"; "") | sub("/.*"; "")),
     (if .CurrentTailnet.MagicDNSEnabled then "magicdns" else empty end)]
    | join(", ")')"
if [[ -z "$dns_upstream" ]]; then
    printf '%s\tdns\tsystem resolver\n' "$label"
elif [[ "$corp_dns" == true ]]; then
    printf '%sset --accept-dns=false\tdns\t%s\n' "$highlight" "$dns_upstream"
else
    printf 'set --accept-dns\tdns\t%s\n' "$dns_upstream"
fi

routes="$(jq -r '[.Peer[]? | . as $p | (.PrimaryRoutes // [])[] | "\(.) via \($p.DNSName | split(".")[0])"] | join(", ")' <<<"$status")"
if [[ "$(jq -r '[.Peer[]? | select(.ExitNode) | .PrimaryRoutes | length > 0] | any' <<<"$status")" == true ]]; then
    printf '%s\troutes\t%s\n' "$label" "$routes"
elif [[ "$route_all" == true ]]; then
    printf '%sset --accept-routes=false\troutes\t%s\n' "$highlight" "$routes"
else
    printf 'set --accept-routes\troutes\t%s\n' "$routes"
fi

if [[ "$has_exit_node" != true ]]; then
    printf '%s\tlan\texit node access\n' "$label"
elif [[ "$lan_access" == true ]]; then
    printf '%sset --exit-node-allow-lan-access=false\tlan\texit node access\n' "$highlight"
else
    printf 'set --exit-node-allow-lan-access\tlan\texit node access\n'
fi

jq -r --arg highlight "$highlight" --arg label "$label" '
    [.Peer[]?]
    | sort_by(.ExitNodeOption, (.DNSName | split(".")[0]))
    | .[]
    | [(if .ExitNode then "\($highlight)set --exit-node="
        elif .ExitNodeOption then "set --exit-node=\(.TailscaleIPs[0])"
        else $label end),
       "peer", (.DNSName | split(".")[0]), .TailscaleIPs[0], (if .Online then "online" else "offline" end),
       (if .Active | not then "" elif .CurAddr != "" then "direct" else "relay \(.Relay)" end),
       (if .Location then "\(.Location.Country) \(.Location.City)" else .OS end | ascii_downcase),
       "rx", .RxBytes, "tx", .TxBytes, (if .ExitNodeOption then "exit node" else "" end)]
    | @tsv' <<<"$status" \
    | numfmt -d$'\t' --field=9,11 --to=iec
