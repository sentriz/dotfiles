#!/usr/bin/env bash

set -u

if [[ "$#" -gt 0 ]]; then
    wl-copy -n <<<"$1"
    exit
fi

cmenu set \
    colour 2 \
    debounce 100ms

if [[ -z "$CMENU_INPUT" ]]; then
    echo "$(cmenu label)no input"
    exit
fi

if ! out="$(numb "$CMENU_INPUT" 2>&1)"; then
    echo "$(cmenu label)${out%%$'\n'*}"
    exit 0
fi

echo "$out"
