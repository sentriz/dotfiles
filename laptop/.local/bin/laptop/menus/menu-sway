#!/usr/bin/env bash

set -u

if [[ "$#" -gt 0 ]]; then
    IFS=$'\t' read -r id _ <<<"$1"
    sway-focus focus "$id"
    exit
fi

cmenu set \
    colour 7 \
    hide 1

sway-focus list | awk -F'\t' -v hl="$(cmenu highlight)" '
{ split($1, id, ":") }
id[3] == "" { printf "%s%s\t%s\t%s\n", ($3 != "" ? hl : ""), $1, $2, (id[2] != "" ? $4 : $5); next }
{ sub(/[?#].*/, "", $6); printf "%s%s\t\t%s %s\n", ($3 != "" ? hl : ""), $1, $6, $5 }
'
