#!/usr/bin/env bash

set -u

settings="$XDG_CONFIG_HOME/pi/agent/settings.json"
state="$XDG_RUNTIME_DIR/menu-llm-$PPID"
session="menu-llm-$PPID"

if [[ "$#" -gt 0 ]]; then
    IFS=$'\t' read -r _ _ action <<<"$1"
    case "$action" in
    "") wl-copy -n <<<"$1" ;;
    copy-session) wl-copy -n <<<"$session" ;;
    set-spec:*) printf '%s\n' "${action#set-spec:}" >"$state" ;;
    esac
    exit
fi

label="$(cmenu label)"

cmenu set \
    colour 2 \
    wrap true \
    debounce 200ms \
    hide 3

spec="$(jq -r '.defaultProvider + "/" + .defaultModel + ":" + .defaultThinkingLevel' "$settings")"
[[ -s "$state" ]] && read -r spec <"$state"
model="${spec%:*}" thinking="${spec##*:}"

if [[ "${CMENU_INPUT-}" != *\? ]]; then
    readarray -t models < <(jq -r '.enabledModels[]' "$settings")
    thinkings=(off low medium high)

    for i in "${!models[@]}"; do [[ "${models[i]}" = "$model" ]] && break; done
    next_model="${models[$(((i + 1) % ${#models[@]}))]}"

    for i in "${!thinkings[@]}"; do [[ "${thinkings[i]}" = "$thinking" ]] && break; done
    next_thinking="${thinkings[$(((i + 1) % ${#thinkings[@]}))]}"

    stay="$(cmenu stay)"

    printf '%smodel\t%s\tset-spec:%s\n' "$stay" "$model" "$next_model:$thinking"
    printf '%sthinking\t%s\tset-spec:%s\n' "$stay" "$thinking" "$model:$next_thinking"
    printf 'session\t%s\tcopy-session\n' "$session"
    echo "$label"
    echo "${label}no question"
    exit
fi

echo "$label$spec"
printf 'session\t%s\tcopy-session\n' "$session"
echo "$label"

pi \
    --model "$spec" \
    --no-tools \
    --no-prompt-templates \
    --no-context-files \
    --no-skills \
    --no-extensions \
    --session-dir "$XDG_RUNTIME_DIR/pi/menu-llm-sessions" \
    --session-id "$session" \
    --system-prompt "Answer concisely in plain text only. No markdown, no latex." \
    --print "${CMENU_INPUT-}" \
    | awk -v label="$label" '{ gsub(/\t/, " ") } NF { print; next } { print label }'

exit 0
