#!/usr/bin/env bash

set -u

if [[ "$#" -gt 0 ]]; then
    IFS=$'\t' read -r action _ _ _ peer mime source <<<"$1"
    if [[ "$action" == "receive" ]]; then
        tailscale file get --conflict=rename "$XDG_DOWNLOAD_DIR" || notify-send "receive failed"
        exit 0
    fi

    if ! path="$(current-files resolve "$source" "$mime")"; then
        notify-send "send failed" "$source is gone"
        exit 0
    fi

    if ! tailscale file cp "$path" "$peer:"; then
        notify-send "send failed" "$(basename "$path") to $peer"
        exit 0
    fi

    notify-send "sent" "$(basename "$path") to $peer"

    exit
fi

pending="$(tailscale debug localapi v0/files/ 2>/dev/null \
    | jq -r '(. // []) | select(length > 0) | [([.[].Size] | add), ([.[].Name] | join(", "))] | @tsv' \
    | numfmt -d$'\t' --field=1 --to=iec)"
[[ -n "$pending" ]] && printf 'receive\t%s\t\t\n' "$pending"

peers="$(tailscale status --json | jq -r '
    select(.BackendState == "Running") | .Self.UserID as $user | .Peer[]?
    | select(.Online and .UserID == $user) | .DNSName | split(".")[0]')"
if [[ -z "$peers" ]]; then
    echo "$(cmenu label)no peers online"
    exit 0
fi

cmenu set \
    colour 14 \
    stay_open true \
    hide 6,7

while IFS=$'\t' read -r _ mime source; do
    if [[ -f "$source" ]]; then
        label="$(basename "$(dirname "$source")")/$(basename "$source")"
        size="$(du -h "$source" | cut -f1)"
    else
        label="$source $mime"
        size="$(wl-paste --type "$mime" 2>/dev/null | wc -c | numfmt --to=iec)"
    fi

    for peer in $peers; do
        printf 'send\t%s\t%s\tto\t%s\t%s\t%s\n' "$size" "$label" "$peer" "$mime" "$source"
    done
done < <(current-files)
