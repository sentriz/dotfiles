#!/usr/bin/env bash

set -u

index_file="$XDG_RUNTIME_DIR/block_playing_index"

function index() {
    cat "$index_file" 2>/dev/null || echo 0
}

function mpris() {
    mpris-ctrl -player-index "$(index)" "$@"
}

if [[ "$#" -gt 0 ]]; then
    IFS=$'\t' read -r _ id <<<"$1"
    case "$id" in
    player) tee "$index_file" <<<"$(($(index) + 1))" >/dev/null ;;
    *) mpris "$id" ;;
    esac
    block-up playing
    exit
fi

status="$(mpris)"
[[ -n "$status" ]] && printf '%s%s\n' "$(cmenu label)" "$status"

cmenu set \
    colour 14 \
    stay_open true \
    hide 2

printf '%s\t%s\n' \
    play-pause play-pause \
    "next track" next \
    "previous track" previous \
    stop stop \
    "next player" player
