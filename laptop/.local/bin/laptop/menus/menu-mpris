#!/usr/bin/env bash

set -u

index_file="$XDG_RUNTIME_DIR/mpris_player_index"

function index() {
    cat "$index_file" 2>/dev/null || echo 0
}

if [[ "$#" -gt 0 ]]; then
    IFS=$'\t' read -r id _ <<<"$1"
    case "$id" in
    index:*) tee "$index_file" <<<"${id#index:}" >/dev/null ;;
    *) mpris-ctrl -player-index "$(index)" "$id" >/dev/null ;;
    esac
    block-up playing
    exit
fi

cmenu set \
    colour 14 \
    stay_open true \
    hide 1

mapfile -t players < <(mpris-ctrl)
count="${#players[@]}"

if ((count)); then
    highlight="$(cmenu highlight)"
    current=$((($(index) % count + count) % count))

    for i in "${!players[@]}"; do
        pre=""
        [[ "$i" == "$current" ]] && pre="$highlight"
        printf '%s%s\tplayer %s\n' "$pre" "index:$i" "${players[i]}"
    done
fi

printf '%s\t%s\t\t\n' \
    play-pause "play-pause" \
    next "next" \
    previous "previous" \
    stop "stop"
