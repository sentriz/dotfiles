#!/usr/bin/env bash

set -u

if [[ "$CMENU_MODE" = "preview" ]]; then
    IFS=$'\t' read -r _ mac _ <<<"$1"
    bluetoothctl info "$mac" \
        | sed -nE 's/^\t([^:]+): (.+)/\1\t\2/p' \
        | grep -v '^UUID' \
        | lower | table
    exit 0
fi

notify() {
    notify-send --hint "string:x-dunst-stack-tag:$0" "$1" "$(strip-escape <<<"${@:2}")"
}

if [[ "$#" -gt 0 ]]; then
    IFS=$'\t' read -r action mac name <<<"$1"

    if [[ "$action" == disconnect ]]; then
        bluetoothctl -- disconnect "$mac" >/dev/null 2>&1
    else
        notify "bluetooth $name" "$(bluetoothctl -- power on)"
        notify "bluetooth $name" "$(bluetoothctl -- connect "$mac" | grep -v "^\[")"
    fi

    block-up bluetooth
    block-up audio
    exit
fi

cmenu set \
    colour 12 \
    preview true \
    stay_open true

if ! pidof -q bluetoothd; then
    echo "$(cmenu label)bluetooth off"
    exit 0
fi

readarray -t connected_macs < <(bluetoothctl devices Connected | lower | col " " 2)

highlight="$(cmenu highlight)"

cmenu set hide 1,2
bluetoothctl devices | grep "^D" | lower | while IFS=" " read -r _ mac name; do
    pre="" action=connect
    [[ "${connected_macs[*]}" =~ $mac ]] && pre="$highlight" action=disconnect
    printf '%s%s\t%s\t%s\n' "$pre" "$action" "$mac" "$name"
done
