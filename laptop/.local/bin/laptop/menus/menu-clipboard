#!/usr/bin/env bash

set -u

if [[ "$CMENU_MODE" = "preview" ]]; then
    IFS=$'\t' read -r _ id _ text mime <<<"$1"
    case "$mime" in
    image/*) cliphist decode "$id" | cmenu image - ;;
    text/* | application/json | application/xml) cliphist decode "$id" ;;
    *) printf '%s\n' "$text" ;;
    esac
    exit 0
fi

if [[ "$#" -gt 0 ]]; then
    IFS=$'\t' read -r action id _ _ mime <<<"$1"

    if [[ "$action" == delete ]]; then
        printf '%s\n' "$id" | cliphist delete
        exit
    fi

    copy_args=()
    [[ -n "$mime" ]] && copy_args=(--type "$mime")
    cliphist decode "$id" | wl-copy "${copy_args[@]}"
    exit
fi

IFS=$'\t' read -r newest_id mime < <(cliphist list -fields id,mime | head -1)
[[ -z "$newest_id" ]] && exit 0

# the newest entry is the clipboard, unless something has copied or cleared it since
current_id=""
paste_args=(-n)
[[ -n "$mime" ]] && paste_args+=(--type "$mime")
cmp -s <(cliphist decode "$newest_id") <(wl-paste "${paste_args[@]}" 2>/dev/null) && current_id="$newest_id"

cmenu set \
    colour 3 \
    preview true \
    hide 1,2,5

pre="" action=copy
[[ "$CMENU_INPUT" = "del" ]] && pre="$(cmenu stay)" action=delete

cliphist list -fields id,timestamp,preview,mime \
    | tr -d '\000' \
    | beside "col 2 | numb '$EPOCHSECONDS - {}' | relative-duration" \
    | awk -F'\t' -v hl="$(cmenu highlight)" -v cur="$current_id" -v pre="$pre" -v action="$action" \
        '{ printf "%s%s%s\t%s\t%s\t%s\t%s\n", pre, ($1 == cur ? hl : ""), action, $1, ($5 == "0s" ? "now" : $5 " ago"), $3, $4 }'
