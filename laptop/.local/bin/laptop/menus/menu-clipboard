#!/usr/bin/env bash

set -u

if [[ "${CMENU_MODE-}" = "preview" ]]; then
    IFS=$'\t' read -r id text <<<"$1"

    if [[ "$text" != "[[ binary data "*" ]]" ]]; then
        cliphist decode "$id"
    elif [[ "$text" =~ [0-9]+x[0-9]+\ \]\]$ ]]; then
        cliphist decode "$id" | cmenu image -
    fi
    exit 0
fi

if [[ "$#" -gt 0 ]]; then
    IFS=$'\t' read -r id _ <<<"$1"

    if [[ "${CMENU_INPUT-}" = "del" ]]; then
        printf '%s\t\n' "$id" | cliphist delete
        exit
    fi

    cliphist decode "$id" | wl-copy
    exit
fi

newest_id="$(cliphist list | head -1 | cut -f1)"
[[ -z "$newest_id" ]] && exit 0

# the newest entry is the clipboard, unless something has copied or cleared it since
current_id=""
cmp -s <(cliphist decode "$newest_id") <(wl-paste -n 2>/dev/null) && current_id="$newest_id"

cmenu set \
    colour 3 \
    preview true \
    hide 1

pre=""
[[ "${CMENU_INPUT-}" = "del" ]] && pre="$(cmenu stay)"

cliphist list \
    | awk -F'\t' -v hl="$(cmenu highlight)" -v cur="$current_id" -v pre="$pre" \
        '{ id = $1; sub(/^[^\t]*\t/, ""); gsub(/\t/, " "); printf "%s%s%s\t%s\n", pre, (id == cur ? hl : ""), id, $0 }'
