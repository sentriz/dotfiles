#!/usr/bin/env bash

set -u

acpi_out="$(acpi -b 2>/dev/null | head -1)"
[[ -z "$acpi_out" ]] && exit

batt_level="$(echo "$acpi_out" | grep -oP '[0-9]+(?=%)')"
[[ -z "$batt_level" ]] && exit
[[ "$batt_level" -ge "100" ]] && exit

status="battery"
if echo "$acpi_out" | grep -iq "\bcharging"; then
    status="charging"
fi

warning=""
if [[ "$status" = "battery" && "$batt_level" -le "10" ]]; then
    beep 1 75 &
    disown
    warning=" ⚠"
fi

power=""
if [[ "$status" = "battery" ]]; then
    current_ua="$(cat /sys/class/power_supply/BAT1/current_now)"
    voltage_uv="$(cat /sys/class/power_supply/BAT1/voltage_now)"
    power_w="$((current_ua * voltage_uv / 1000000000000))"
    [[ "$power_w" -gt "0" ]] && power=" ${power_w}W"
fi

echo "$status ${batt_level}%$power$warning"
