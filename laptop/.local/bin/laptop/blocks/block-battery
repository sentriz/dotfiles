#!/usr/bin/env bash

set -u

batts=(/sys/class/power_supply/BAT*)
batt="${batts[0]}"
[[ -e "$batt" ]] || exit

batt_level="$(cat "$batt/capacity")"
[[ "$batt_level" -ge "100" ]] && exit

status="charging"
if [[ "$(cat "$batt/status")" = "Discharging" ]]; then
    status="battery"
fi

warning=""
if [[ "$status" = "battery" && "$batt_level" -le "10" ]]; then
    beep 1 75 &
    disown
    warning=" ⚠"
fi

power=""
if [[ "$status" = "battery" ]]; then
    current_ua="$(cat "$batt/current_now")"
    voltage_uv="$(cat "$batt/voltage_now")"
    power_w="$((current_ua * voltage_uv / 1000000000000))"
    [[ "$power_w" -gt "0" ]] && power=" ${power_w}W"
fi

echo "$status ${batt_level}%$power$warning"
