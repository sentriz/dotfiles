#!/usr/bin/env bash

set -u

# requires:
# - https://github.com/sentriz/mpris-ctrl

index_file="$XDG_RUNTIME_DIR/mpris_player_index"

function index() {
    cat "$index_file" 2>/dev/null || echo 0
}

function scroll() {
    tee "$index_file" <<<$(($(index) + $1)) >/dev/null
}

command=()
case "${BLOCK_BUTTON-}" in
1) command=(play-pause) ;; # left click
3) command=(stop) ;;       # right click
4) scroll +1 ;;            # scroll up
5) scroll -1 ;;            # scroll down
esac

mapfile -t players < <(mpris-ctrl -player-index "$(index)" "${command[@]}")
count="${#players[@]}"
((count)) || exit

current=$((($(index) % count + count) % count))
IFS=$'\t' read -r _ status title <<<"${players[current]}"
[[ -n "$title" ]] || exit

((${#title} > 40)) && title="${title:0:40}…"
((count > 1)) && status+=" $((current + 1))/$count"

printf '%s %s\n' "$status" "$title"
