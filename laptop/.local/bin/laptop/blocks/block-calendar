#!/usr/bin/env fish

set now_secs (date "+%s")
set buffer_secs (math "6 * 3600")

khal list today tomorrow -df "" --json start-date --json start-time --json end-date --json end-time --json cancelled --json title --json alarms-list \
    | jq -r '.[] | select(.cancelled == "") | [."start-date", ."start-time", ."end-date", ."end-time", .title, (."alarms-list" | map(.delta) | join(" "))] | @tsv' \
    | while read -d \t start_date start_time end_date end_time title alarms
    set is_all_day 0
    if test -z "$start_time"
        set is_all_day 1
        set start_time 00:00
        set end_time "00:00 next day"
    end

    set start_secs (date -d "$start_date $start_time" "+%s")
    set end_secs (date -d "$end_date $end_time" "+%s")
    test "$now_secs" -gt "$end_secs"; and continue

    set diff (math "$start_secs - $now_secs")
    for alarm in (string split -n " " -- $alarms)
        set until_alarm (math "$start_secs + $alarm - $now_secs")
        if test "$until_alarm" -le 0; and test "$until_alarm" -gt -30
            set rel now
            test "$diff" -gt 0; and set rel "in "(relative-duration $diff 2)
            notify-send -- "$title" "$rel"
        end
    end

    test "$diff" -gt "$buffer_secs"; and continue

    # rank by start clamped to now, so events already running all tie and the earliest-ending one wins
    printf '%s\t%s\t%s\t%s\t%s\n' $is_all_day (math "max($start_secs, $now_secs)") $end_secs $start_secs "$title"
end | sort -t \t -k1,1n -k2,2n -k3,3n | head -1 | read -d \t is_all_day key_secs end_secs next_start next_title

test -z "$next_start"; and exit 0

set rel now
set diff (math "$next_start - $now_secs")
test "$diff" -gt 0; and set rel "in "(relative-duration $diff 2)
echo "($rel) "(string shorten -m 30 -c … -- "$next_title")
