#!/usr/bin/env bash

set -u

if [[ "$#" -gt 0 ]]; then
    IFS=$'\t' read -r _ id <<<"$1"
    case "$id" in
    lock) swaylock ;;
    exit) swaymsg exit ;;
    reload) swaymsg reload ;;
    esac
    exit
fi

cmenu set \
    colour 11 \
    hide 2

printf '%s\t%s\n' \
    "lock screen" lock \
    "exit sway" exit \
    "reload config" reload
