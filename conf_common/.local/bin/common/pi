#!/usr/bin/env bash

pi_bin=$(PATH="/usr/bin:/usr/local/bin" command -v pi)

extra_dirs=()
pi_args=()
parsing_binds=""
for arg in "$@"; do
    if [ -n "$parsing_binds" ]; then
        extra_dirs+=("$(realpath "$arg")")
    elif [ "$arg" = "--" ]; then
        parsing_binds=1
    else
        pi_args+=("$arg")
    fi
done

if [ -n "$PI_UNSANDBOXED" ]; then
    PI_CODING_AGENT_DIR="$XDG_CONFIG_HOME/pi/agent" PI_OFFLINE=1 exec "$pi_bin" "${pi_args[@]}"
fi

cwd=$(realpath "$PWD")

extra_binds=()
for dir in "${extra_dirs[@]}"; do
    extra_binds+=(--bind "$dir" "$dir")
done

if [ ${#extra_dirs[@]} -gt 0 ]; then
    pi_args+=(--append-system-prompt "Additional directories available outside the working directory: ${extra_dirs[*]}")
fi

mkdir -p "$XDG_CACHE_HOME/jiti"
mkdir -p "$XDG_RUNTIME_DIR/mcp"
mkdir -p "$XDG_RUNTIME_DIR/pi"

socks=()
session_binds=()
cleanups=()

cleanup() {
    for cmd in "${cleanups[@]}"; do eval "$cmd"; done
    return 0
}
trap cleanup EXIT

if [ -n "$DBUS_SESSION_BUS_ADDRESS" ]; then
    dbus_sock="$XDG_RUNTIME_DIR/pi/bus.$$"
    xdg-dbus-proxy "$DBUS_SESSION_BUS_ADDRESS" "$dbus_sock" --filter --talk=org.freedesktop.Notifications &
    cleanups+=("kill $!" "rm -f ${dbus_sock@Q}")
    socks+=("$dbus_sock")
    session_binds+=(--bind-try "$dbus_sock" "$dbus_sock" --setenv DBUS_SESSION_BUS_ADDRESS "unix:path=$dbus_sock")
fi

secrets_sock="$XDG_RUNTIME_DIR/pi/secrets.$$"
socat "UNIX-LISTEN:$secrets_sock,fork,mode=600" "EXEC:$(command -v secret-get)" 2>/dev/null &
cleanups+=("kill $!" "rm -f ${secrets_sock@Q}")
socks+=("$secrets_sock")
session_binds+=(--bind "$secrets_sock" "$secrets_sock" --setenv SECRETS_SOCK "$secrets_sock")

if [ -n "$WAYLAND_DISPLAY" ]; then
    wayland_sock="$XDG_RUNTIME_DIR/pi/wayland.$$"
    way-secure --socket-path "$wayland_sock" -e pi -a pi &
    cleanups+=("kill $!" "rm -f ${wayland_sock@Q}")
    socks+=("$wayland_sock")
    session_binds+=(--bind-try "$wayland_sock" "$wayland_sock" --setenv WAYLAND_DISPLAY "$wayland_sock")
fi

if [ ${#socks[@]} -gt 0 ]; then
    for _ in $(seq 50); do
        missing=""
        for sock in "${socks[@]}"; do [ -e "$sock" ] || missing=1; done
        [ -z "$missing" ] && break
        sleep 0.05
    done
fi

bwrap \
    --ro-bind / / \
    --dev /dev \
    --proc /proc \
    --tmpfs /tmp \
    --bind "$XDG_CACHE_HOME/jiti" /tmp/jiti \
    --tmpfs "$HOME/.ssh" \
    --ro-bind-try "$HOME/.ssh/config" "$HOME/.ssh/config" \
    --ro-bind-try "$HOME/.ssh/known_hosts" "$HOME/.ssh/known_hosts" \
    --tmpfs /etc/ssh/ssh_config.d \
    --bind "$cwd" "$cwd" \
    --chdir "$cwd" \
    --bind "$XDG_CONFIG_HOME/pi" "$XDG_CONFIG_HOME/pi" \
    --setenv PI_CODING_AGENT_DIR "$XDG_CONFIG_HOME/pi/agent" \
    --bind "$XDG_CACHE_HOME" "$XDG_CACHE_HOME" \
    --bind "$XDG_DATA_HOME/go/pkg/mod" "$XDG_DATA_HOME/go/pkg/mod" \
    --bind "$XDG_DATA_HOME/tasks/" "$XDG_DATA_HOME/tasks/" \
    --tmpfs "$XDG_RUNTIME_DIR" \
    --bind "$XDG_DOWNLOAD_DIR" "$XDG_DOWNLOAD_DIR" \
    --bind "$XDG_RUNTIME_DIR/mcp" "$XDG_RUNTIME_DIR/mcp" \
    --bind "$XDG_RUNTIME_DIR/pi" "$XDG_RUNTIME_DIR/pi" \
    --bind-try "$SSH_AUTH_SOCK" "$SSH_AUTH_SOCK" \
    "${session_binds[@]}" \
    --bind "$PROJECTS_DIR" "$PROJECTS_DIR" \
    "${extra_binds[@]}" \
    --setenv PI_OFFLINE 1 \
    --unsetenv SWAYSOCK \
    --unshare-all \
    --share-net \
    --die-with-parent \
    "$pi_bin" \
    "${pi_args[@]}"
