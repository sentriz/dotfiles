#!/usr/bin/env bash

if [ -n "$SECRETS_SOCK" ]; then
    exec socat - "UNIX-CONNECT:$SECRETS_SOCK" <<<"$1"
fi

case "$1" in
write)
    key=$2
    value=$3

    printf '\n%s\n' "$value" | rbw edit --folder dotfiles "secret $key" 2>/dev/null \
        || printf '\n%s\n' "$value" | rbw add --folder dotfiles "secret $key"
    ;;
list)
    rbw list --fields folder,name | grep -P "dotfiles\tsecret" | col -1 | col " " -1
    ;;
*)
    rbw get --folder dotfiles --field notes "secret $1" 2>/dev/null
    ;;
esac
